# =============================================================================
# 部署配置 —— 整个项目**唯一**需要改的文件
#
#   cp config.env.example config.env   # 然后按需修改（不要提交这个文件）
#
# 改完：bash scripts/ops.sh doctor    # 体检
#
# ⚠️ 这里只放**占位符** —— 真实值（账号 id / 库 id / 域名 / 凭据）不要进版本库。
#    每个值怎么拿，写在对应行的注释里。
# =============================================================================

# ───────────────────────── 站点 ─────────────────────────
# 站点根地址 —— canonical / hreflang / sitemap / RSS / OG 全靠它拼绝对地址
# 要跟 astro.config.mjs 里的 site 一致（ops.sh config set SITE_URL 会两边同步）
SITE_URL=""

# ───────────────────────── 站点文案 ─────────────────────────
# 站点名 / 笔名 / 标语 / 首页大标题 / 关于页引言 —— 这些**默认文字**不在这里，
# 它们在 `config/site.json`（入库的配置文件，一眼看就懂）。
# 仓库里只放**默认值**（可公开）；个人文字（站名 / 笔名 / 邮箱）不要提交进仓库，
# 去后台「设置」分区改 —— 存 D1 的 settings 表，构建时导出成 overrides.ts 盖在默认值上。
# 这里只放**环境值**（地址、库 id、凭据）。

# ───────────────────────── 部署目标（Cloudflare Workers）─────────────────────────
# Worker 名字（cloudflare/wrangler.jsonc 里的 name）
WORKER_NAME=""
# D1 数据库名与 id（id 从 `pnpm wrangler d1 create <名字>` 的输出里抄）
D1_DATABASE_NAME=""
D1_DATABASE_ID=""
# R2 桶名（`pnpm wrangler r2 bucket create <名字>`）
R2_BUCKET_NAME=""
# Cloudflare 账号 id（`pnpm wrangler whoami` 里的 Account ID）
CLOUDFLARE_ACCOUNT_ID=""

# ───────────────────────── 后台凭据 ─────────────────────────
# 后台口令的 SHA-256（十六进制）。改口令：
#   printf '%s' '你的口令' | shasum -a 256 | cut -d' ' -f1
# 线上用 `pnpm wrangler secret put ADMIN_PASSWORD_HASH`，本地由 ops.sh env 写进 .dev.vars
ADMIN_PASSWORD_HASH=""
# 会话签名密钥（随机长串：openssl rand -hex 32）
SESSION_SECRET=""
# 构建钩子（Cloudflare Workers Builds 的 Deploy Hook URL）**只放线上 Worker secret**，
# 不要写进这个文件、也不要进 .dev.vars —— 本地发布会误触发线上构建：
#   pnpm wrangler secret put DEPLOY_HOOK_URL --config cloudflare/wrangler.jsonc
# 没配它 = 后台改完内容不会重建（站点要手动去 Cloudflare 触发构建）。
