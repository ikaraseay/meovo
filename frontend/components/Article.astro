---
/**
 * 文章页的外壳 —— 标题卡、正文、目录、关系图谱、上下篇、页脚。
 * ---------------------------------------------------------
 * 页面只管路由与数据（哪篇文章、哪些语言版本）；chrome 全在这一份：
 * 卡片摆在哪（zone）、目录怎么折叠、复制按钮怎么注入，都归这里。
 *
 * 正文走插槽：渲染好的 markdown 由页面传进来 —— 这一块不属于 chrome。
 */
import GlassWidget from './GlassWidget.astro'
import OutlineMap from './OutlineMap.astro'
import PostLicense from './PostLicense.astro'
import PostMeta from './PostMeta.astro'
import TextFoldBar from './TextFoldBar.astro'
import TranslationNotice from './TranslationNotice.astro'
import { t, localeLabel, defaultLocale, type Locale } from '../i18n'
import {
  getPostLocale,
  getPostSlug,
  readingTime,
  type Post,
} from '../lib/posts'
import { tocGroups, tocHeadings, type Heading } from '../lib/content-queries'
import {
  postPath,
  tagPath,
  seriesPath,
} from '../lib/urls'
import {
  getTagLabel,
} from '../lib/posts'

interface Props {
  /** 这篇文章（内容语言可能与 URL 语言不同） */
  post: Post
  /** markdown 目录 */
  headings: Heading[]
  /** URL 上的语言 */
  locale: Locale
  /** 显示的是原文（当前语言还没有这个版本） */
  isFallback: boolean
  /** 同一个翻译组里的各语言版本 */
  variants: Post[]
  prev?: { title: string; href: string }
  next?: { title: string; href: string }
}

const { post, headings, locale, isFallback, variants, prev, next } = Astro.props

/** 目录只收 h2 / h3 —— 再深的层级在侧栏里没有意义 */
const tocItems = tocHeadings(headings)

/** 目录按一级章节分组 —— 每个一级章节自己可折叠 */
const groups = tocGroups(tocItems)

/** 阅读时间按**内容语言**算，不是按 URL 上的语言 */
const minutes = readingTime(post.body ?? '', getPostLocale(post))

/**
 * 协议按**翻译组**取 —— 同一篇文章的中英文版本得挂同一个协议。
 * （每份 frontmatter 各写各的，中文版改了英文版没改，就会出现一篇文章两个协议）
 */
const licensePost = variants.find((v) => getPostLocale(v) === defaultLocale) ?? post
---

<div class="desk" data-desk data-desk-flow>
  <!-- 标题卡：顶部通栏 -->
  <GlassWidget id="article-head" zone="top" width="xl" locale={locale}>
    <div class="post-head">
      <h1 class="post-title" id="article-title">{post.data.title}</h1>
      <PostMeta post={post} locale={locale} readingMinutes={minutes} />
    </div>
  </GlassWidget>

  <!-- 目录与关系图谱：桌面排在正文右侧栏；窄屏放不下就落到标题卡下面 ——
       所以 DOM 顺序 = 窄屏的视觉顺序（标题 → 目录 → 关系图谱 → 正文） -->
  {
    tocItems.length > 0 && (
      <GlassWidget id="article-toc" zone="side" width="sm" defaultPin locale={locale}>
        <nav class="toc" aria-label={t(locale, 'post.toc')} data-toc>
          <button type="button" class="toc-toggle" data-toc-toggle aria-expanded="false">
            <span>{t(locale, 'post.toc')}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <ul class="toc-list">
            {groups.map((group) => (
              <li
                class="toc-group"
                data-toc-group={group.heading?.slug ?? ''}
                data-open="false"
              >
                {group.heading ? (
                  group.children.length > 0 ? (
                    /* 一级章节自己可折叠 —— 默认收起：浏览位置到了自动展开，
                       双击手动展开（这时右边才留那个箭头） */
                    <div class="toc-summary">
                      <a
                        class="toc-link toc-link--section"
                        href={`#${group.heading.slug}`}
                        data-toc-link={group.heading.slug}
                      >
                        {group.heading.text}
                      </a>
                      <button
                        class="toc-chevron"
                        type="button"
                        data-toc-chevron
                        aria-expanded="false"
                        aria-controls={`toc-sub-${group.heading.slug}`}
                        aria-label={t(locale, 'post.tocToggle')}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                          />
                        </svg>
                      </button>
                    </div>
                    <div
                      class="toc-sublist-wrap"
                      id={`toc-sub-${group.heading.slug}`}
                      data-toc-sublist
                      inert
                    >
                      <ul class="toc-sublist">
                        {group.children.map((item) => (
                          <li class="toc-item">
                            <a class="toc-link" href={`#${item.slug}`} data-toc-link={item.slug}>
                              {item.text}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ) : (
                    /* 没有子章节 —— 不可折叠，就是一行链接 */
                    <div class="toc-summary toc-summary--plain">
                      <a
                        class="toc-link toc-link--section"
                        href={`#${group.heading.slug}`}
                        data-toc-link={group.heading.slug}
                      >
                        {group.heading.text}
                      </a>
                    </div>
                  )
                ) : (
                  group.children.map((item) => (
                    <li class="toc-item toc-item--depth-3">
                      <a class="toc-link" href={`#${item.slug}`} data-toc-link={item.slug}>
                        {item.text}
                      </a>
                    </li>
                  ))
                )}
              </li>
            ))}
          </ul>
        </nav>
      </GlassWidget>
    )
  }

  {
    (post.data.tags.length > 0 || post.data.series) && (
      <GlassWidget id="article-outline" zone="side" width="sm" defaultPin locale={locale}>
        <OutlineMap
          locale={locale}
          tags={post.data.tags.map((tag) => ({
            label: getTagLabel(locale, tag),
            href: tagPath(locale, tag),
          }))}
          series={post.data.series
            ? { label: post.data.series.title, href: seriesPath(locale, post.data.series.id) }
            : undefined}
        />
      </GlassWidget>
    )
  }

  <!-- 折叠阅读：侧栏卡片，排在关系图谱后面 —— 跟目录 / 关系图谱一样默认固定，
       窄屏退回文档流时也紧跟关系图谱（DOM 顺序 = 视觉顺序） -->
  <GlassWidget id="article-fold" zone="side" width="sm" defaultPin locale={locale}>
    <TextFoldBar locale={locale} />
  </GlassWidget>

  <!-- 正文：正常文档流，位置永远不变；卡片绝对定位在四周，不占它的空间 -->
  <article class="post-content" data-desk-content>
    {isFallback && <TranslationNotice locale={locale} post={post} />}

    <div
      class="prose"
      data-copy-label={t(locale, 'post.copyCode')}
      data-copied-label={t(locale, 'post.copied')}
      data-image-close={t(locale, 'post.image.close')}
      data-image-label={t(locale, 'post.image.label')}
      data-article-key={`${getPostLocale(post)}/${getPostSlug(post)}`}
    >
      <slot />
    </div>
  </article>

  <!-- 协议卡：正文后面 —— 跟上下篇一样是可拖走的玻璃部件，只是位置固定在文末这一段 -->
  <GlassWidget id="article-license" zone="tail" width="lg" locale={locale}>
    <PostLicense post={licensePost} locale={locale} />
  </GlassWidget>

  {
    (prev || next) && (
      <GlassWidget id="article-nav" zone="tail" width="lg" locale={locale}>
        <nav class="post-nav" aria-label={t(locale, 'post.navigation')}>
          {prev && (
            <a class="ui-card ui-card--sm ui-card--interactive post-nav-item" href={prev.href}>
              <span class="post-nav-label">{t(locale, 'post.prev')}</span>
              <span class="post-nav-title">{prev.title}</span>
            </a>
          )}
          {next && (
            <a
              class="ui-card ui-card--sm ui-card--interactive post-nav-item post-nav-item--next"
              href={next.href}
            >
              <span class="post-nav-label">{t(locale, 'post.next')}</span>
              <span class="post-nav-title">{next.title}</span>
            </a>
          )}
        </nav>
      </GlassWidget>
    )
  }

  <GlassWidget id="article-footer" zone="tail" width="lg" locale={locale}>
    <div class="post-footer">
      <a class="ui-btn ui-btn--secondary" href={`/${locale}/`}>
        {t(locale, 'nav.home')}
      </a>

      {
        variants.length > 1 && (
          <div class="post-translations">
            <span class="ui-text--muted">{t(locale, 'post.translations')}</span>
            {variants.map((variant) => (
              <a
                class="ui-chip"
                href={postPath(getPostLocale(variant), getPostSlug(variant))}
                hreflang={getPostLocale(variant)}
              >
                {localeLabel(getPostLocale(variant), locale)}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </GlassWidget>
</div>

<!-- 评论功能已停用：组件在 frontend/components/Comments.astro，
     恢复只要把 <Comments slug={getPostSlug(post)} locale={locale} /> 放回这里 -->

<script>
  import { initImageZoom } from '../lib/image-zoom'
  import { initTextFold, type TextFoldLabels } from '../lib/text-fold'
  import { relayoutDesks } from '../lib/draggable'
  import {
    activeHeadingId,
    contentInset,
    MIN_INSET,
    openGroupIds,
    toggleGroupMode,
    type TocGroupMode,
  } from '../lib/toc'
  import { ATTR } from '../lib/dom-contract'

  /* ---------- 目录：折叠 + 精确跳转 + 滚动高亮 ---------- */

  const toc = document.querySelector<HTMLElement>('[data-toc]')
  const tocToggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]')

  /**
   * 让位高度 —— 悬浮栏下面留多少，章节就落在那儿。
   *
   * 写进 --ui-content-offset：正文的 scroll-margin-top 用它，
   * 锚点跳转（目录点击、别的页内链接、带 # 的网址进来）都不会被栏压住。
   */
  let contentOffset = MIN_INSET

  function syncContentOffset() {
    const bar = document.querySelector<HTMLElement>(`[${ATTR.floatMenu}]`)
    const rect = bar?.getBoundingClientRect()
    const box = rect && rect.height > 0 ? { top: rect.top, bottom: rect.bottom } : null
    contentOffset = contentInset(box, window.innerHeight)
    document.documentElement.style.setProperty('--ui-content-offset', `${contentOffset}px`)
  }
  syncContentOffset()
  window.addEventListener('resize', syncContentOffset)
  // 悬浮栏被拖走 —— 让位高度跟着变
  window.addEventListener('pointerup', syncContentOffset, { passive: true })

  /** 首屏带 #锚点进来的 —— 浏览器原生跳转不知道悬浮栏占多高，补一次 */
  function fixHashTarget() {
    let id = ''
    try {
      id = decodeURIComponent(location.hash.slice(1))
    } catch {
      id = location.hash.slice(1) // 手改坏的百分号编码 —— 别让整段挂掉
    }
    const target = id ? document.getElementById(id) : null
    if (!target) return
    const top = target.getBoundingClientRect().top + window.scrollY - contentOffset
    // instant —— 首屏直接落到位，别再演一遍平滑滚动
    window.scrollTo({ top: Math.max(0, top), behavior: 'instant' })
  }

  /* 窄屏那行折叠头：收起 / 展开整张目录（桌面看不到它） */
  tocToggle?.addEventListener('click', () => {
    if (!toc) return
    const open = toc.hasAttribute('data-open')
    toc.toggleAttribute('data-open', !open)
    tocToggle.setAttribute('aria-expanded', String(!open))
  })

  /* ---------- 一级章节：默认全收起，位置自动展开，双击手动切换 ---------- */

  /** 每个一级章节一组（data-toc-group = 章节 slug） */
  const tocGroups = [...document.querySelectorAll<HTMLElement>('[data-toc-group]')]

  /** 每组的状态 —— 双击过的就不再跟浏览位置走 */
  const groupModes = new Map<string, TocGroupMode>()

  /** 当前章节的链接 —— 位置驱动的展开跟着它 */
  let activeLink: HTMLAnchorElement | null = null

  /** 组里那层子章节 —— 没有子章节的组没有它，也就不可折叠 */
  function groupSublist(group: HTMLElement): HTMLElement | null {
    return group.querySelector('[data-toc-sublist]')
  }

  /** 这一组现在是开着还是收着 */
  function groupIsOpen(group: HTMLElement): boolean {
    return group.dataset.open === 'true'
  }

  /** 哪些组该展开 —— 位置规则 + 手动覆盖 */
  function syncGroups() {
    const activeGroupId =
      activeLink?.closest<HTMLElement>('[data-toc-group]')?.dataset.tocGroup ?? ''
    const open = new Set(
      openGroupIds(
        tocGroups.map((group) => ({
          id: group.dataset.tocGroup ?? '',
          collapsible: Boolean(groupSublist(group)),
        })),
        activeGroupId,
        groupModes,
      ),
    )
    for (const group of tocGroups) {
      const id = group.dataset.tocGroup ?? ''
      const wrap = groupSublist(group)
      if (!wrap) continue
      const wantOpen = open.has(id)
      if (groupIsOpen(group) === wantOpen) continue
      group.dataset.open = String(wantOpen)
      // 收起时子章节真藏掉 —— 不可聚焦、不可点
      wrap.toggleAttribute('inert', !wantOpen)
      group.querySelector('[data-toc-chevron]')?.setAttribute('aria-expanded', String(wantOpen))
      // 卡片高度变了，固定卡那一摞要重排（动完了还会再排一次）
      relayoutDesks()
    }
  }

  /** 手动切换 —— 当前开着就收起，收着就展开（手动过就不再跟位置走） */
  function toggleGroup(group: HTMLElement, wasOpen: boolean) {
    const id = group.dataset.tocGroup ?? ''
    if (!groupSublist(group)) return
    const mode = groupModes.get(id) ?? 'auto'
    groupModes.set(id, toggleGroupMode(mode, wasOpen))
    syncGroups()
  }

  for (const group of tocGroups) {
    const wrap = groupSublist(group)
    const summary = group.querySelector('.toc-summary')
    if (!wrap || !summary) continue

    // 收起 / 展开都有动画 —— 高度动完了再重排一次（这时卡片高度才定下来）
    wrap.addEventListener('transitionend', (event) => {
      if ((event as TransitionEvent).propertyName === 'grid-template-rows') relayoutDesks()
    })

    // 双击按「点下去那一刻」的状态算 —— 点章节名会跳转，
    // 跳转可能顺手把这一组展开，那时再读就晚了
    let openBeforeClick = false
    summary.addEventListener('mousedown', () => {
      openBeforeClick = groupIsOpen(group)
    })

    summary.addEventListener('dblclick', (event) => {
      event.preventDefault()
      toggleGroup(group, openBeforeClick)
    })

    // 箭头：点它开 / 收这一组（悬停才现身，鼠标移开 1 秒后淡出）
    const chevron = group.querySelector('[data-toc-chevron]')
    chevron?.addEventListener('click', (event) => {
      const click = event as MouseEvent
      // 双击的第二次点击 —— 别连着切两次
      if (click.detail > 1) return
      event.stopPropagation()
      toggleGroup(group, groupIsOpen(group))
    })
    // 双击箭头别再冒到行上（行上双击也是切换）
    chevron?.addEventListener('dblclick', (event) => event.stopPropagation())
  }

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')]
  const tocHeadings = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null)

  /** 目录自己会滚 —— 当前章节滚出视野时把它带回来（只滚目录，不动页面） */
  function keepActiveVisible(link: HTMLAnchorElement) {
    const list = link.closest('.toc-list')
    if (!list) return
    const rect = link.getBoundingClientRect()
    // 收起的组里 —— 那条链接没有位置，别把目录滚歪
    if (rect.height === 0) return
    const box = list.getBoundingClientRect()
    if (rect.top < box.top) list.scrollTop -= box.top - rect.top
    else if (rect.bottom > box.bottom) list.scrollTop += rect.bottom - box.bottom
  }

  function syncActiveHeading() {
    const active = activeHeadingId(
      tocHeadings.map((heading) => ({
        id: heading.id,
        top: heading.getBoundingClientRect().top,
      })),
      contentOffset,
    )
    activeLink = null
    for (const link of tocLinks) {
      const isActive = link.dataset.tocLink === active
      link.classList.toggle('is-active', isActive)
      if (isActive) activeLink = link
    }
    // 先展开当前那组，再把它带进视野（收起的组里链接没有位置）
    syncGroups()
    if (activeLink) keepActiveVisible(activeLink)
  }

  if (tocHeadings.length > 0) {
    let ticking = false
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          syncActiveHeading()
          ticking = false
        })
      },
      { passive: true },
    )
    syncActiveHeading()
  }

  // 带 #锚点进来的 —— 等浏览器的原生跳转落地后补一次（它不知道悬浮栏占多高）
  window.addEventListener('load', () => requestAnimationFrame(fixHashTarget))

  /* ---------- 代码块：语言标签 + 复制按钮 ---------- */

  const prose = document.querySelector<HTMLElement>('.prose')
  const copyLabel = prose?.dataset.copyLabel ?? ''
  const copiedLabel = prose?.dataset.copiedLabel ?? ''

  document.querySelectorAll<HTMLElement>('.prose pre.astro-code').forEach((pre) => {
    const wrapper = document.createElement('div')
    wrapper.className = 'code-block'
    pre.parentNode?.insertBefore(wrapper, pre)
    wrapper.appendChild(pre)

    const language = pre.dataset.language
    if (language) {
      const tag = document.createElement('span')
      tag.className = 'code-lang'
      tag.textContent = language
      wrapper.appendChild(tag)
    }

    const button = document.createElement('button')
    button.type = 'button'
    button.className = 'code-copy'
    button.textContent = copyLabel
    button.setAttribute('aria-label', copyLabel)
    wrapper.appendChild(button)

    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? ''
      try {
        await navigator.clipboard.writeText(code)
      } catch {
        // 剪贴板不可用（非安全上下文 / 权限拒绝）—— 选中代码，用户自己复制
        const range = document.createRange()
        range.selectNodeContents(pre)
        const selection = window.getSelection()
        selection?.removeAllRanges()
        selection?.addRange(range)
        return
      }
      button.textContent = copiedLabel
      button.classList.add('is-copied')
      window.setTimeout(() => {
        button.textContent = copyLabel
        button.classList.remove('is-copied')
      }, 2000)
    })
  })

  /* ---------- 图片：点开能放大、能拖着挪 ---------- */

  initImageZoom([...document.querySelectorAll<HTMLImageElement>('.prose img')], {
    close: prose?.dataset.imageClose ?? '',
    label: prose?.dataset.imageLabel ?? '',
  })

  /* ---------- 折叠阅读：全文 / 简述（作者原句）/ 要点（模型的话） ---------- */

  const foldBar = document.querySelector<HTMLElement>('[data-text-fold]')
  if (foldBar && prose) {
    const labelsEl = foldBar.querySelector<HTMLScriptElement>('[data-text-fold-labels]')
    let labels: TextFoldLabels | null = null
    try {
      labels = labelsEl ? (JSON.parse(labelsEl.textContent ?? '') as TextFoldLabels) : null
    } catch {
      labels = null
    }
    if (labels) {
      initTextFold(prose, foldBar, labels, {
        // 文章 key —— 用来查 AI 摘要
        articleKey: prose.dataset.articleKey,
        // 正文高度变了：目录高亮跟着重算，桌面尾部卡片跟着重排
        onChange: () => {
          syncActiveHeading()
          requestAnimationFrame(relayoutDesks)
        },
      })
    }
  }
</script>

<style>
  /* 正文：正常文档流，固定一个适合阅读的宽度，居中显示；卡片绝对定位在四周，互不占位 */
  .post-content {
    position: relative;
    width: min(760px, 100%);
    margin-inline: auto;
  }

  .post-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-block-end: var(--ui-space-md);
  }

  /* ==================== 上一篇 / 下一篇 ==================== */
  .post-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--ui-space-md);
  }

  .post-nav-item {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-xs);
    min-width: 0;
    text-decoration: none;
  }

  .post-nav-item--next {
    text-align: end;
  }

  .post-nav-label {
    color: var(--ui-text-muted);
    font-size: 0.75rem;
  }

  .post-nav-title {
    color: var(--ui-text-secondary);
    font-weight: 500;
  }

  .post-nav-item:hover .post-nav-title {
    color: var(--ui-text-accent);
  }

  /* ==================== 页脚 ==================== */
  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-md);
    flex-wrap: wrap;
  }

  .post-translations {
    display: flex;
    align-items: center;
    gap: var(--ui-space-sm);
    flex-wrap: wrap;
    font-size: 0.875rem;
  }

  .post-translations a.ui-chip {
    text-decoration: none;
    color: var(--ui-text-secondary);
