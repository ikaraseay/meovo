---
/** 图谱展示当前文章的标签和系列关系。 */
import { t, type Locale } from '../i18n'
import { DESKTOP_MIN_WIDTH } from '../lib/breakpoint'
import { buildRelationGraph } from '../lib/relation-graph'

interface Props {
  locale: Locale
  tags?: Array<{ label: string; href: string }>
  series?: { label: string; href: string }
}

const { locale, tags = [], series } = Astro.props
const links = [
  ...tags.map((tag) => ({ kind: 'tag' as const, label: tag.label, href: tag.href })),
  ...(series ? [{ kind: 'series' as const, label: series.label, href: series.href }] : []),
]
const graph = buildRelationGraph(links)
---

<details class="outline-map" data-outline data-desktop-min={DESKTOP_MIN_WIDTH}>
  <summary class="outline-summary">{t(locale, 'post.structure')}</summary>
  {
    graph.nodes.length <= 1 ? null : (
      <div class="outline-scroll" role="region" tabindex="0" aria-label={t(locale, 'post.structure')}>
        <div class="graph-viewport" data-graph-viewport>
          <svg
            class="outline-svg"
            viewBox={`0 0 ${graph.width} ${graph.height}`}
            width={graph.width}
            height={graph.height}
            role="img"
            aria-label={t(locale, 'post.structure')}
          >
            <g data-graph-transform>
              {graph.edges.map((edge) => {
                const source = graph.nodes.find((node) => node.id === edge.source)!
                const target = graph.nodes.find((node) => node.id === edge.target)!
                const mx = (source.x + target.x) / 2 + edge.curve
                const my = (source.y + target.y) / 2 - edge.curve
                return <path class="outline-line" data-edge-source={source.id} data-edge-target={target.id} data-curve={edge.curve} d={`M ${source.x} ${source.y} Q ${mx} ${my} ${target.x} ${target.y}`} />
              })}
              {graph.nodes.map((node) => {
                const href = node.href
                const content = (
                  <>
                    <circle class="outline-hit" cx={node.x} cy={node.y} r={14} />
                    <circle cx={node.x} cy={node.y} r={node.kind === 'root' ? 10 : 5} />
                    {node.label && <text x={node.x} y={node.y + 14} text-anchor="middle">
                      {node.label.length > 14 ? `${node.label.slice(0, 13)}…` : node.label}
                    </text>}
                    {node.label && <title>{node.label}</title>}
                  </>
                )
                return href ? (
                  <a href={href} class={`outline-node outline-node--${node.kind}`} data-node={node.id} data-x={node.x} data-y={node.y}>{content}</a>
                ) : (
                  <g class="outline-node outline-node--root" data-node={node.id} data-x={node.x} data-y={node.y}>{content}</g>
                )
              })}
            </g>
          </svg>
        </div>
      </div>
    )
  }
</details>

<script>
  import { driftOffset, driftState } from '../lib/relation-graph'
  import {
    createPhysics,
    magnetSnap,
    pinBody,
    releaseBody,
    stepPhysics,
  } from '../lib/graph-physics'

  ;(() => {
    const el = document.querySelector<HTMLElement>('[data-outline]')
    const min = el?.dataset.desktopMin
    if (!el || !min) return
    const mq = window.matchMedia(`(min-width: ${min}px)`)
    const sync = () => {
      if (mq.matches) el.setAttribute('open', '')
    }
    sync()
    mq.addEventListener('change', sync)

    const viewport = el.querySelector<HTMLElement>('[data-graph-viewport]')
    const transform = el.querySelector<SVGGElement>('[data-graph-transform]')
    if (!viewport || !transform) return

    let scale = 1
    let panX = 0
    let panY = 0
    let draggingNode = ''
    let pendingGrab = ''
    let snappedNode = ''
    let suppressClick = false
    let dragOffset = { x: 0, y: 0 }
    let dragBase = { x: 0, y: 0 }
    let moved = false
    let downPoint = { x: 0, y: 0 }
    const svg = viewport.querySelector('svg')
    if (!svg) return

    /** 屏幕坐标 → 图谱坐标（走变换组的 CTM，含平移与缩放） */
    const toGraph = (clientX: number, clientY: number) => {
      const matrix = transform.getScreenCTM()
      if (!matrix) return { x: 0, y: 0 }
      const point = new DOMPoint(clientX, clientY).matrixTransform(matrix.inverse())
      return {
        x: point.x,
        y: point.y,
      }
    }

    /** 图坐标一个单位对应多少屏幕像素（含 viewBox 缩放与滚轮缩放） */
    const graphScale = () => {
      const matrix = transform.getScreenCTM()
      return matrix ? Math.hypot(matrix.a, matrix.b) || 1 : 1
    }

    /** 按屏幕实际位置找最近的节点 —— 图坐标会因缩放 / 飘动 / 受力偏移而失配 */
    const nearestByScreen = (clientX: number, clientY: number): string => {
      // 先看指针正压在哪个节点上（命中区大，小节点也好点）
      const hit = document.elementFromPoint(clientX, clientY)?.closest('[data-node]')
      const hitId = hit?.getAttribute('data-node')
      if (hitId) return hitId
      // 没有压中就找屏幕距离最近的
      let best = ''
      let bestDistance = Infinity
      nodes.forEach((node) => {
        const circle = node.querySelector('circle:not(.outline-hit)')
        if (!circle) return
        const rect = circle.getBoundingClientRect()
        const dx = clientX - (rect.left + rect.width / 2)
        const dy = clientY - (rect.top + rect.height / 2)
        const distance = Math.hypot(dx, dy)
        if (distance < bestDistance) {
          best = node.getAttribute('data-node') ?? ''
          bestDistance = distance
        }
      })
      return best
    }

    const apply = () => {
      transform.setAttribute('transform', `translate(${panX} ${panY}) scale(${scale})`)
      transform.style.transformOrigin = 'center'
    }
    viewport.addEventListener('wheel', (event: WheelEvent) => {
      event.preventDefault()
      const rect = viewport.getBoundingClientRect()
      const pointX = event.clientX - rect.left
      const pointY = event.clientY - rect.top
      const oldScale = scale
      const nextScale = Math.max(0.65, Math.min(3.5, scale * (event.deltaY < 0 ? 1.12 : 0.89)))
      panX = pointX - ((pointX - panX) * nextScale / oldScale)
      panY = pointY - ((pointY - panY) * nextScale / oldScale)
      scale = nextScale
      apply()
    }, { passive: false })
    const nodes = [...el.querySelectorAll<SVGElement>('[data-node]')]
    const edges = [...el.querySelectorAll<SVGPathElement>('[data-edge-source]')]

    /* 受力模拟：拖一个节点时，邻居被连边弹簧拽着走 */
    const physicsBodies = nodes.map((node) => ({
      id: node.getAttribute('data-node') ?? '',
      x: Number(node.getAttribute('data-x')),
      y: Number(node.getAttribute('data-y')),
    }))
    const physicsSprings = edges.map((edge) => ({
      source: edge.getAttribute('data-edge-source') ?? '',
      target: edge.getAttribute('data-edge-target') ?? '',
    }))
    let physics = createPhysics(physicsBodies, physicsSprings)
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const drift = new Map<string, ReturnType<typeof driftState>>()
    const nodeBase = new Map<string, { x: number; y: number }>()
    nodes.forEach((node, index) => {
      const id = node.getAttribute('data-node') ?? String(index)
      drift.set(id, driftState(id))
      nodeBase.set(id, {
        x: Number(node.getAttribute('data-x')),
        y: Number(node.getAttribute('data-y')),
      })
    })
    const edgeMeta = edges.map((edge) => ({
      el: edge,
      source: edge.getAttribute('data-edge-source') ?? '',
      target: edge.getAttribute('data-edge-target') ?? '',
      curve: Number(edge.getAttribute('data-curve')),
    }))
    const offsetOf = (id: string, time: number) => {
      const info = drift.get(id)
      if (!info) return { x: 0, y: 0 }
      return driftOffset(info, time)
    }
    let driftTime = 0
    const physicsOffset = new Map<string, { x: number; y: number }>()
    const tick = () => {
      requestAnimationFrame(tick)
      if (reduceMotion.matches || !viewport.isConnected) return
      driftTime += 0.016
      physics = stepPhysics(physics, 1)
      physics.bodies.forEach((body) => {
        const base = nodeBase.get(body.id)
        if (!base) return
        physicsOffset.set(body.id, { x: body.x - base.x, y: body.y - base.y })
      })
      nodes.forEach((node) => {
        const id = node.getAttribute('data-node') ?? ''
        if (!nodeBase.has(id)) return
        const offset = offsetOf(id, driftTime)
        const pushed = physicsOffset.get(id)
        const dx = offset.x + (pushed?.x ?? 0)
        const dy = offset.y + (pushed?.y ?? 0)
        node.setAttribute('transform', `translate(${dx.toFixed(2)} ${dy.toFixed(2)})`)
      })
      edgeMeta.forEach((edge) => {
        const source = nodeBase.get(edge.source)
        const target = nodeBase.get(edge.target)
        if (!source || !target) return
        const from = offsetOf(edge.source, driftTime)
        const to = offsetOf(edge.target, driftTime)
        const sourcePush = physicsOffset.get(edge.source)
        const targetPush = physicsOffset.get(edge.target)
        const x1 = source.x + from.x + (sourcePush?.x ?? 0)
        const y1 = source.y + from.y + (sourcePush?.y ?? 0)
        const x2 = target.x + to.x + (targetPush?.x ?? 0)
        const y2 = target.y + to.y + (targetPush?.y ?? 0)
        const mx = (x1 + x2) / 2 + edge.curve
        const my = (y1 + y2) / 2 - edge.curve
        edge.el.setAttribute(
          'd',
          `M ${x1.toFixed(2)} ${y1.toFixed(2)} Q ${mx.toFixed(2)} ${my.toFixed(2)} ${x2.toFixed(2)} ${y2.toFixed(2)}`,
        )
      })
    }
    if (!reduceMotion.matches) requestAnimationFrame(tick)

    /** 抓住一个节点：位置由指针接管，按住期间不回弹 */
    const grabNode = (id: string, event: PointerEvent) => {
      draggingNode = id
      viewport.setPointerCapture(event.pointerId)
      viewport.classList.add('is-dragging-node')
      nodes.forEach((node) => {
        node.classList.toggle('is-dragging', node.getAttribute('data-node') === id)
      })
      const body = physics.bodies.find((item) => item.id === id)
      if (!body) return
      // 拖动用「屏幕位移」驱动 —— 图坐标会因缩放 / 飘动失配，节点会跳
      const drift = offsetOf(id, driftTime)
      dragOffset = {
        x: event.clientX,
        y: event.clientY,
      }
      dragBase = { x: body.x + drift.x, y: body.y + drift.y }
      physics = pinBody(physics, id, body.x, body.y)
    }

    /** 画布上按住 —— 自动抓住离指针最近的节点 */
    viewport.addEventListener('pointerdown', (event: PointerEvent) => {
      if (draggingNode || pendingGrab) return
      const target = nearestByScreen(event.clientX, event.clientY)
      if (!target) return
      const point = toGraph(event.clientX, event.clientY)
      moved = false
      downPoint = point
      pendingGrab = target
    })

    viewport.addEventListener('pointermove', (event: PointerEvent) => {
      const point = toGraph(event.clientX, event.clientY)
      if (pendingGrab && !moved && Math.hypot(point.x - downPoint.x, point.y - downPoint.y) > 3) {
        moved = true
        // 真的在拖了 —— 这时才接管指针，别让链接跳转
        event.preventDefault()
        viewport.setPointerCapture(event.pointerId)
        grabNode(pendingGrab, event)
      }
      if (!draggingNode) return
      const id = draggingNode
      const anchors = physics.bodies
        .filter((body) => body.id !== id)
        .map((body) => ({ id: body.id, x: body.x, y: body.y }))
      // 屏幕位移 → 图坐标位移（按缩放换算）
      const target = {
        x: dragBase.x + (event.clientX - dragOffset.x) / graphScale(),
        y: dragBase.y + (event.clientY - dragOffset.y) / graphScale(),
      }
      const snapped = magnetSnap(target, anchors)
      physics = pinBody(physics, id, snapped.x, snapped.y)
      if (snapped.snapped !== snappedNode) {
        snappedNode = snapped.snapped
        nodes.forEach((other) => {
          other.classList.toggle('is-snapped', other.getAttribute('data-node') === snappedNode)
        })
      }
    })

    const releaseNode = () => {
      if (draggingNode) {
        physics = releaseBody(physics, draggingNode)
        draggingNode = ''
        snappedNode = ''
        nodes.forEach((other) => other.classList.remove('is-dragging'))
        nodes.forEach((other) => other.classList.remove('is-snapped'))
        viewport.classList.remove('is-dragging-node')
      }
      // 拖过就吞掉这一次点击 —— 免得松手时跳到链接目标
      if (moved) {
        suppressClick = true
        // click 在 pointerup 之后才派发 —— 用延时兜底，别过早放开
        setTimeout(() => { suppressClick = false }, 300)
      }
      pendingGrab = ''
    }
    viewport.addEventListener('pointerup', releaseNode)
    viewport.addEventListener('pointercancel', releaseNode)

    // 捕获阶段拦下「拖完松手」多出来的那一次点击
    viewport.addEventListener('click', (event: MouseEvent) => {
      if (!suppressClick) return
      event.preventDefault()
      event.stopPropagation()
    }, true)

    nodes.forEach((node) => {
      // SVG 里的 <a> 会被浏览器当成可拖的链接 —— 拖节点时别触发原生拖拽
      node.addEventListener('dragstart', (event) => event.preventDefault())
      node.addEventListener('pointerenter', () => {
        const id = node.getAttribute('data-node')
        el.classList.add('is-focusing')
        nodes.forEach((other) => {
          other.classList.toggle('is-related', other.getAttribute('data-node') === id)
        })
        edges.forEach((edge) => {
          const source = edge.getAttribute('data-edge-source')
          const target = edge.getAttribute('data-edge-target')
          edge.classList.toggle('is-related', source === id || target === id)
        })
      })
      node.addEventListener('pointerleave', () => {
        el.classList.remove('is-focusing')
        nodes.forEach((other) => other.classList.remove('is-related'))
        edges.forEach((edge) => edge.classList.remove('is-related'))
      })
    })
  })()
</script>

<style>
  .outline-map { margin: 0; }
  .outline-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-sm);
    padding-block: var(--ui-space-xs);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ui-text-secondary);
    cursor: pointer;
  }
  .outline-summary::marker { content: ''; }
  .outline-scroll {
    position: relative;
    max-height: min(38vh, 24rem);
    max-height: min(38dvh, 24rem);
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .graph-viewport {
    min-height: 240px;
    height: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }
  .graph-viewport.is-dragging { cursor: grabbing; }
  .outline-svg { display: block; width: 100%; height: 240px; }
  .outline-line {
    stroke: var(--ui-border);
    stroke-width: 1;
    fill: none;
    transition: stroke var(--ui-duration-fast), stroke-width var(--ui-duration-fast), opacity var(--ui-duration-fast);
  }
  .outline-node {
    cursor: grab;
    user-select: none;
    transition: opacity var(--ui-duration-fast);
    animation: graph-node-in var(--ui-duration-normal) both;
  }
  .outline-node:nth-of-type(2n) {
    animation-delay: 60ms;
  }
  .outline-node:nth-of-type(3n) {
    animation-delay: 120ms;
  }
  @keyframes graph-node-in {
    from { opacity: 0; scale: 0.82; }
    to { opacity: 1; scale: 1; }
  }
  /* 命中区：透明大圆，让小节点也好点、好抓 */
  .outline-node .outline-hit {
    fill: transparent;
    stroke: none;
  }
  .outline-node circle:not(.outline-hit) {
    fill: var(--ui-text-secondary);
    transition: r var(--ui-duration-fast), filter var(--ui-duration-fast), fill var(--ui-duration-fast);
  }
  .outline-node:hover circle:not(.outline-hit) {
    r: 8;
  }
  .outline-node--root:hover circle:not(.outline-hit) { r: 12; }
  .outline-node.is-dragging circle:not(.outline-hit) {
    r: 11;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--ui-accent) 65%, transparent));
  }
  .outline-node.is-snapped circle:not(.outline-hit) {
    r: 10;
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--ui-text-accent) 70%, transparent));
  }
  .graph-viewport.is-dragging-node {
    cursor: grabbing;
  }
  .graph-viewport.is-dragging-node .outline-node {
    cursor: grabbing;
  }
  .outline-node.is-related circle:not(.outline-hit) {
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--ui-accent) 55%, transparent));
  }
  .outline-map.is-focusing .outline-node:not(.is-related) circle:not(.outline-hit) {
    opacity: 0.32;
  }
  .outline-line.is-related {
    stroke: var(--ui-accent);
    stroke-width: 2;
  }
  .outline-node--root circle:not(.outline-hit) { fill: var(--ui-accent); }
  .outline-node--root circle:not(.outline-hit) {
    animation: graph-root-pulse var(--ui-duration-slow) ease-in-out infinite alternate;
  }
  @keyframes graph-root-pulse {
    from { filter: drop-shadow(0 0 0 transparent); }
    to { filter: drop-shadow(0 0 6px color-mix(in srgb, var(--ui-accent) 45%, transparent)); }
  }
  .outline-node--series circle:not(.outline-hit) { fill: var(--ui-text-accent); }
  .outline-node--tag circle:not(.outline-hit) { fill: transparent; stroke: var(--ui-text-accent); stroke-width: 2; }
  .outline-node text {
    fill: var(--ui-text-secondary);
    font-family: var(--ui-font-body);
    font-size: 8.5px;
    user-select: none;
    /* 文字要能点（打开标签或系列）—— 靠 user-select 挡住拖选，不靠 pointer-events */
    pointer-events: auto;
  }
  @media (min-width: 1024px) {
    .outline-summary { display: none; }
  }
  :global(.ui-widget.is-expanded) .outline-scroll {
    max-height: calc(90vh - 100px);
  }
  :global(.ui-widget.is-expanded) .graph-viewport,
  :global(.ui-widget.is-expanded) .outline-svg {
    height: calc(90vh - 140px);
  }
</style>
