---
/**
 * 页脚 —— 一张可拖拽的玻璃卡片（在 BaseLayout 里包在 [data-desk] 中）。
 * 位置相对固定在页面底部，但也能拖走。
 */
import GlassWidget from './GlassWidget.astro'
import { t, type Locale } from '../i18n'
import { FOOTER_HEIGHT_KEY, parseFooterMinHeight } from '../lib/footer-height.ts'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const year = new Date().getFullYear()
/** 后台设的页脚卡片最小高度（px）—— 0 = 不限 */
const minHeight = parseFooterMinHeight(t(locale, FOOTER_HEIGHT_KEY))
/** 备案号 —— 默认值是占位（里面没有数字）；有数字才算真配过，链接也用它 */
const icp = t(locale, 'footer.icp')
const icpNumber = icp.match(/\d+/)?.[0] ?? ''
/** 页脚附加内容 —— 后台可编辑，**按裸 HTML 渲染**；留空 = 不显示 */
const custom = t(locale, 'footer.custom')
---

<GlassWidget id="footer" width="auto" full locale={locale} minHeight={minHeight}>
  <div class="footer-inner">
    <p class="footer-copyright">
      {t(locale, 'footer.copyright', { year, name: t(locale, 'site.author') })}
    </p>

    <div class="footer-links">
      {icpNumber && (
        <a href={`https://icp.gov.moe/?keyword=${icpNumber}`} target="_blank">{icp}</a>
      )}
      <span class="footer-note ui-text--muted">{t(locale, 'footer.builtWith')}</span>
    </div>
    {/* 附加内容按**裸 HTML** 渲染 —— 作者要写链接、图标就写标签 */}
    {custom && <div class="footer-custom" set:html={custom}></div>}
  </div>
</GlassWidget>

<style>
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-md);
    flex-wrap: wrap;
    font-size: 0.875rem;
  }

  .footer-copyright {
    color: var(--ui-text-secondary);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--ui-space-md);
    flex-wrap: wrap;
  }

  .footer-custom {
    flex-basis: 100%;
    color: var(--ui-text-secondary);
    /* 纯文本的换行留着；HTML 标签自己管排版 */
    white-space: pre-line;
  }

  .footer-link {
    color: var(--ui-text-secondary);
    text-decoration: none;
    transition: color var(--ui-transition-fast);
  }

  .footer-link:hover {
    color: var(--ui-text-accent);
  }
</style>
