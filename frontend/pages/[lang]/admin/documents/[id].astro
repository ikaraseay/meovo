---
/**
 * 文档编辑器 —— 新建 / 修改 / 预览 / 插图 / 导入 .md。
 *
 * 中英文各摆一块编辑界面：同一篇文章的两个语言版本，
 * 标题 / 摘要 / 正文各自独立，slug 与分类这些字段共用。
 * 改完一起保存 —— 上线由「构建上线」那一步决定。
 */
export const prerender = false

import AdminLayout from '../../../../layouts/AdminLayout.astro'
import { t, type Locale } from '../../../../i18n'
import { LICENSES, LICENSE_IDS } from '../../../../lib/licenses'

const locale = (Astro.params.lang as Locale) ?? 'zh'
const docId = Astro.params.id ?? 'new'
const isNew = docId === 'new'
const langs = ['zh', 'en'] as const
---

<AdminLayout
  locale={locale}
  section="documents"
  title={t(locale, isNew ? 'admin.editor.new' : 'admin.editor.edit')}
  intro={t(locale, isNew ? 'admin.editor.newIntro' : 'admin.editor.editIntro')}
>
  <div slot="actions" class="admin-head__group">
    <span class="admin-pill admin-pill--ghost" data-admin-status hidden></span>
    <a class="ui-btn" data-admin-view hidden target="_blank" rel="noopener">
      {t(locale, 'admin.action.view')}
    </a>
    <button class="ui-btn ui-btn--primary" type="button" data-admin-publish>
      {t(locale, 'admin.action.publish')}
    </button>
  </div>

  <form class="admin" data-admin-editor data-doc-id={docId}>
    <section class="admin-card">
      <h2 class="admin-card__title">{t(locale, 'admin.card.basics')}</h2>
      <div class="admin-grid">
        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.slug')}</span>
          <input class="ui-input admin-input--mono" type="text" name="slug" required />
          <span class="admin-field__hint">{t(locale, 'admin.hint.slug')}</span>
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.pubDate')}</span>
          <input class="ui-input" type="date" name="pubDate" />
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.updatedDate')}</span>
          <input class="ui-input" type="date" name="updatedDate" />
        </label>
      </div>
    </section>

    <section class="admin-card">
      <h2 class="admin-card__title">{t(locale, 'admin.card.taxonomy')}</h2>
      <div class="admin-grid">
        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.category')}</span>
          <input class="ui-input admin-input--mono" type="text" name="category" />
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.tags')}</span>
          <input class="ui-input admin-input--mono" type="text" name="tags" />
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.license')}</span>
          <select class="ui-input" name="license">
            {LICENSE_IDS.map((id) => (
              <option value={id}>{t(locale, LICENSES[id].nameKey)}</option>
            ))}
          </select>
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.seriesId')}</span>
          <input class="ui-input admin-input--mono" type="text" name="seriesId" />
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.seriesTitle')}</span>
          <input class="ui-input" type="text" name="seriesTitle" />
        </label>

        <label class="admin-field">
          <span class="admin-field__label">{t(locale, 'admin.field.seriesOrder')}</span>
          <input class="ui-input" type="number" name="seriesOrder" min="1" />
        </label>
      </div>
    </section>

    {
      langs.map((lang) => (
        <section class="admin-card" data-admin-lang={lang}>
          <div class="admin-card__head">
            <h2 class="admin-card__title">
              {t(locale, lang === 'zh' ? 'admin.lang.zh' : 'admin.lang.en')}
            </h2>
            <span class="admin-pill admin-pill--ghost" data-admin-lang-status={lang} hidden></span>
          </div>

          <div class="admin-grid">
            <label class="admin-field admin-field--wide">
              <span class="admin-field__label">{t(locale, 'admin.field.title')}</span>
              <input class="ui-input" type="text" name={`title-${lang}`} />
            </label>

            <label class="admin-field admin-field--wide">
              <span class="admin-field__label">{t(locale, 'admin.field.description')}</span>
              <input class="ui-input" type="text" name={`description-${lang}`} />
            </label>
          </div>

          <div class="admin-editor">
            <div class="admin-editor__pane">
              <div
                class="admin-editor__tools"
                data-admin-tools={lang}
                role="toolbar"
                aria-label={t(locale, 'admin.editor.toolbar')}
              ></div>
              <textarea class="ui-input admin-editor__body" name={`body-${lang}`}></textarea>
            </div>
            <div class="admin-editor__pane">
              <span class="admin-field__label">{t(locale, 'admin.action.preview')}</span>
              <div class="admin-preview prose" data-admin-preview={lang}></div>
            </div>
          </div>
        </section>
      ))
    }

    <div class="admin-actionbar">
      <span class="admin-actionbar__meta" data-admin-saved-at hidden></span>
      <div class="admin-actionbar__buttons">
        <button class="ui-btn" type="button" data-admin-preview-button>
          {t(locale, 'admin.action.preview')}
        </button>
        <button class="ui-btn" type="button" data-admin-media-button>
          {t(locale, 'admin.action.insertImage')}
        </button>
        <label class="ui-btn">
          {t(locale, 'admin.action.import')}
          <input type="file" accept=".md,.markdown" hidden data-admin-import />
        </label>
        <button class="ui-btn admin-btn--danger" type="button" data-admin-delete hidden>
          {t(locale, 'admin.action.delete')}
        </button>
        <button class="ui-btn ui-btn--primary" type="submit">
          {t(locale, 'admin.action.save')}
        </button>
      </div>
    </div>

    <div class="admin-media-picker" data-admin-media-picker hidden></div>
  </form>
</AdminLayout>

<script>
  import { ATTR } from '../../../../lib/dom-contract'
  import { t } from '../../../../i18n'
  import { api, errorText, nextToken } from '../../../../../backend/lib/admin/client'
  import { parseFrontmatter } from '../../../../../backend/lib/admin/frontmatter'
  import {
    EDITOR_TOOLS,
    wrapSelection,
    prefixLines,
    insertLink,
    insertTable,
    type EditResult,
  } from '../../../../lib/editor-tools'

  interface DocumentRow {
    id: string
    slug: string
    locale: string
    title: string
    description: string
    body: string
    pub_date: string | null
    updated_date: string | null
    category: string | null
    tags: string
    series_id: string | null
    series_title: string | null
    series_order: number | null
    license: string
    status: string
    updated_at: string
  }

  interface MediaRow {
    id: string
    key: string
    alt: string
    mime: string
  }

  /** 两种语言 —— 各自一份文档，各自带标题 / 摘要 / 正文 */
  type Lang = 'zh' | 'en'
  const LANGS: Lang[] = ['zh', 'en']

  interface DocState {
    id: string | null
    status: string
    updatedAt: string | null
  }

  /** 一块编辑界面：工具栏 + 正文 + 预览 */
  interface Pane {
    lang: Lang
    tools: HTMLElement
    body: HTMLTextAreaElement
    preview: HTMLElement
    timer: number
    seq: number
  }

  const locale = document.documentElement.lang === 'en' ? 'en' : 'zh'
  const form = document.querySelector<HTMLFormElement>('[' + ATTR.adminEditor + ']')
  const flash = document.querySelector<HTMLElement>('[' + ATTR.adminFlash + ']')
  const picker = document.querySelector<HTMLElement>('[' + ATTR.adminMediaPicker + ']')
  const docId = form?.getAttribute('data-doc-id') ?? 'new'
  const statusTag = document.querySelector<HTMLElement>('[data-admin-status]')
  const savedAt = document.querySelector<HTMLElement>('[data-admin-saved-at]')
  const viewLink = document.querySelector<HTMLAnchorElement>('[data-admin-view]')
  const deleteButton = document.querySelector<HTMLButtonElement>('[data-admin-delete]')
  const publishButton = document.querySelector<HTMLButtonElement>('[data-admin-publish]')

  const docs: Record<Lang, DocState> = {
    zh: { id: null, status: 'draft', updatedAt: null },
    en: { id: null, status: 'draft', updatedAt: null },
  }
  const panes: Pane[] = []
  /** 当前在写的那一版 —— 底部那些按钮（插图 / 导入）跟着它走 */
  let activePane: Pane | null = null
  /** 页面上这篇文档是哪种语言 */
  let currentLang: Lang = 'zh'
  let dirty = false

  function field(name: string): HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null {
    return form?.elements.namedItem(name) as HTMLInputElement | null
  }

  function say(message: string, isError = false) {
    if (!flash) return
    flash.textContent = message
    flash.classList.toggle('admin-flash--error', isError)
    flash.hidden = false
    flash.classList.add('admin-flash--visible')
  }

  function setField(name: string, value: string) {
    const element = field(name)
    if (element) element.value = value
  }

  /** 某种语言的字段：title-zh / title-en … */
  function langField(name: string, lang: Lang) {
    return field(name + '-' + lang)
  }

  function setLangField(name: string, lang: Lang, value: string) {
    const element = langField(name, lang)
    if (element) element.value = value
  }

  function safeTags(raw: string): string {
    try {
      const parsed = JSON.parse(raw)
      return Array.isArray(parsed) ? parsed.join(', ') : ''
    } catch {
      return ''
    }
  }

  /** 两种语言共用的字段 */
  function collectShared() {
    return {
      slug: field('slug')?.value ?? '',
      pubDate: field('pubDate')?.value ?? '',
      updatedDate: field('updatedDate')?.value ?? '',
      category: field('category')?.value ?? '',
      tags: field('tags')?.value ?? '',
      license: field('license')?.value ?? 'cc-by',
      seriesId: field('seriesId')?.value ?? '',
      seriesTitle: field('seriesTitle')?.value ?? '',
      seriesOrder: field('seriesOrder')?.value ?? '',
    }
  }

  function fillShared(doc: DocumentRow) {
    setField('slug', doc.slug)
    setField('pubDate', (doc.pub_date ?? '').slice(0, 10))
    setField('updatedDate', (doc.updated_date ?? '').slice(0, 10))
    setField('category', doc.category ?? '')
    setField('tags', safeTags(doc.tags))
    setField('seriesId', doc.series_id ?? '')
    setField('seriesTitle', doc.series_title ?? '')
    setField('seriesOrder', doc.series_order == null ? '' : String(doc.series_order))
    setField('license', doc.license)
  }

  /** 一篇文档 → 一种语言 */
  function fillDoc(lang: Lang, doc: DocumentRow) {
    docs[lang] = { id: doc.id, status: doc.status, updatedAt: doc.updated_at }
    setLangField('title', lang, doc.title)
    setLangField('description', lang, doc.description)
    setLangField('body', lang, doc.body)
    renderLangStatus(lang)
  }

  /** 另一种语言还没有这一版 —— 清空那一块 */
  function clearDoc(lang: Lang) {
    docs[lang] = { id: null, status: 'draft', updatedAt: null }
    setLangField('title', lang, '')
    setLangField('description', lang, '')
    setLangField('body', lang, '')
    renderLangStatus(lang)
  }

  /** 某个语言的发布状态药丸 */
  function renderLangStatus(lang: Lang) {
    const tag = document.querySelector<HTMLElement>('[data-admin-lang-status="' + lang + '"]')
    if (!tag) return
    const state = docs[lang]
    tag.hidden = !state.id
    tag.innerHTML =
      '<span class="admin-pill__dot"></span>' +
      (state.status === 'published'
        ? t(locale, 'admin.status.published')
        : t(locale, 'admin.status.draft'))
  }

  function renderStatus() {
    const state = docs[currentLang]
    const published = state.status === 'published'
    if (statusTag) {
      statusTag.hidden = false
      statusTag.innerHTML =
        '<span class="admin-pill__dot"></span>' +
        (published ? t(locale, 'admin.status.published') : t(locale, 'admin.status.draft'))
    }
    if (savedAt) {
      savedAt.hidden = false
      savedAt.textContent = state.updatedAt
        ? t(locale, 'admin.editor.lastSaved', { time: formatTime(state.updatedAt) })
        : t(locale, 'admin.editor.notPublished')
    }
    if (viewLink) {
      viewLink.hidden = !published
      const slug = field('slug')?.value ?? ''
      if (published && slug) viewLink.href = '/' + currentLang + '/posts/' + slug + '/'
    }
    if (deleteButton) deleteButton.hidden = docId === 'new'
    if (publishButton) {
      publishButton.textContent = published
        ? t(locale, 'admin.action.unpublish')
        : t(locale, 'admin.action.publish')
      publishButton.classList.toggle('ui-btn--primary', !published)
    }
  }

  function formatTime(value: string): string {
    const date = new Date(value)
    if (Number.isNaN(date.getTime())) return value
    return new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
    }).format(date)
  }

  /* ---------------- 保存 ---------------- */

  /** 一篇文档存一次 —— 有了就改，没有就建 */
  async function saveDoc(lang: Lang, publish: boolean): Promise<string | null> {
    const state = docs[lang]
    const title = langField('title', lang)?.value ?? ''
    // 没填标题 —— 这一版就不存在（只写了中文是很正常的事）
    if (!title.trim()) return null
    const payload = {
      ...collectShared(),
      locale: lang,
      title,
      description: langField('description', lang)?.value ?? '',
      body: langField('body', lang)?.value ?? '',
      updatedAt: state.updatedAt ?? '',
    }
    let created = false
    if (state.id) {
      const saved = await api<{ updatedAt?: string }>('/api/admin/documents/' + state.id, {
        method: 'PUT',
        body: JSON.stringify(payload),
      })
      // 令牌换新的 —— 服务端每次写入都换，不换的话第二次保存必然 409
      state.updatedAt = nextToken(state.updatedAt, saved)
    } else {
      const result = await api<{ id?: string; updatedAt?: string }>('/api/admin/documents', {
        method: 'POST',
        body: JSON.stringify(payload),
      })
      state.id = result.id ?? null
      state.updatedAt = nextToken(null, result)
      created = true
    }
    if (publish && state.id) {
      const result = await api<{ updatedAt?: string }>('/api/admin/documents/' + state.id + '/publish', {
        method: 'POST',
        body: JSON.stringify({ published: true }),
      })
      state.updatedAt = nextToken(state.updatedAt, result)
      state.status = 'published'
    }
    renderLangStatus(lang)
    return created ? state.id : null
  }

  async function save(publish: boolean): Promise<boolean> {
    try {
      let created: string | null = null
      for (const lang of LANGS) {
        const id = await saveDoc(lang, publish)
        if (id && !created) created = id
      }
      dirty = false
      renderStatus()
      say(t(locale, publish ? 'admin.hint.published' : 'admin.hint.saved'))
      // 新建完跳到正式页面 —— 两种语言都已经存进库了
      if (created && docId === 'new') {
        location.href = '/' + locale + '/admin/documents/' + (docs[locale as Lang].id ?? created)
        return true
      }
      return true
    } catch (error) {
      const failure = error as { code?: string; errors?: string[] }
      const detail = failure.errors?.map((code) => errorText(locale, code)).join(' / ')
      say(detail || errorText(locale, failure.code ?? 'request_failed'), true)
      return false
    }
  }

  /** 发布 / 撤回 —— 两种语言一起 */
  async function setPublished(published: boolean) {
    try {
      for (const lang of LANGS) {
        const state = docs[lang]
        if (!state.id) continue
        const result = await api<{ updatedAt?: string }>('/api/admin/documents/' + state.id + '/publish', {
          method: 'POST',
          body: JSON.stringify({ published }),
        })
        state.updatedAt = nextToken(state.updatedAt, result)
        state.status = published ? 'published' : 'draft'
        renderLangStatus(lang)
      }
      dirty = false
      renderStatus()
      say(t(locale, published ? 'admin.hint.published' : 'admin.hint.draft'))
    } catch (error) {
      const failure = error as { code?: string }
      say(errorText(locale, failure.code ?? 'request_failed'), true)
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    await save(false)
  });

  form?.addEventListener('input', (event) => {
    dirty = true
    // 正文改了 → 停手就刷新预览
    const pane = panes.find((item) => item.body === event.target)
    if (pane) schedulePreview(pane)
  });

  publishButton?.addEventListener('click', async () => {
    if (docs[currentLang].status === 'published') {
      await setPublished(false)
      return
    }
    await save(true)
  });

  deleteButton?.addEventListener('click', async () => {
    const state = docs[currentLang]
    if (!state.id) return
    if (!confirm(t(locale, 'admin.confirm.delete'))) return
    try {
      await api('/api/admin/documents/' + state.id, { method: 'DELETE' })
      location.href = '/' + locale + '/admin/'
    } catch (error) {
      const failure = error as { code?: string }
      say(errorText(locale, failure.code ?? 'request_failed'), true)
    }
  });

  /* ---------------- 格式工具栏 ---------------- */

  /** 改完正文要自己触发一次 input —— 脏标记与自动预览都听它 */
  function bodyChanged(pane: Pane) {
    pane.body.dispatchEvent(new Event('input', { bubbles: true }))
  }

  /** 把算好的结果写回正文，并把选区挪到新位置 */
  function applyEdit(pane: Pane, edit: EditResult) {
    pane.body.value = edit.value
    pane.body.focus()
    pane.body.setSelectionRange(edit.start, edit.end)
    bodyChanged(pane)
  }

  function applyWrap(pane: Pane, before: string, after: string) {
    applyEdit(
      pane,
      wrapSelection(pane.body.value, pane.body.selectionStart, pane.body.selectionEnd, before, after),
    )
  }

  function applyPrefix(pane: Pane, prefix: string) {
    applyEdit(
      pane,
      prefixLines(pane.body.value, pane.body.selectionStart, pane.body.selectionEnd, prefix),
    )
  }

  /** 链接 / 图片：问一句地址 */
  function applyLink(pane: Pane, image: boolean) {
    const label = t(locale, image ? 'admin.editor.image' : 'admin.editor.link')
    const url = window.prompt(label, 'https://')
    if (!url) return
    applyEdit(
      pane,
      insertLink(pane.body.value, pane.body.selectionStart, pane.body.selectionEnd, url, image),
    )
  }

  function applyTable(pane: Pane) {
    applyEdit(pane, insertTable(pane.body.value, pane.body.selectionStart))
  }

  function renderTools(pane: Pane) {
    pane.tools.textContent = ''
    for (const tool of EDITOR_TOOLS) {
      const button = document.createElement('button')
      button.className = 'ui-btn'
      button.type = 'button'
      if (tool.icon) button.innerHTML = tool.icon
      else button.textContent = tool.label ?? ''
      const label = t(locale, tool.title)
      button.title = label
      button.setAttribute('aria-label', label)
      button.addEventListener('click', () => {
        if (tool.kind === 'link') applyLink(pane, false)
        else if (tool.kind === 'image') applyLink(pane, true)
        else if (tool.kind === 'table') applyTable(pane)
        else if (tool.prefix) applyPrefix(pane, tool.prefix)
        else applyWrap(pane, tool.before ?? '', tool.after ?? '')
      })
      pane.tools.appendChild(button)
    }
  }

  /* ---------------- 预览：停手就刷新 ---------------- */

  async function refreshPreview(pane: Pane) {
    const seq = ++pane.seq
    try {
      const data = await api<{ html: string }>('/api/admin/preview', {
        method: 'POST',
        body: JSON.stringify({ markdown: pane.body.value }),
      })
      // 慢的旧响应不许盖掉新的
      if (seq !== pane.seq) return
      pane.preview.innerHTML = data.html
    } catch (error) {
      const failure = error as { code?: string }
      say(errorText(locale, failure.code ?? 'request_failed'), true)
    }
  }

  /** 正文改完停 400ms 就刷新一次预览 */
  function schedulePreview(pane: Pane) {
    window.clearTimeout(pane.timer)
    pane.timer = window.setTimeout(() => void refreshPreview(pane), 400)
  }

  document
    .querySelector<HTMLButtonElement>('[data-admin-preview-button]')
    ?.addEventListener('click', () => {
      // 没聚焦过正文框就用第一块 —— 点了必须有个反应
      const pane = activePane ?? panes[0]
      if (!pane) return
      void refreshPreview(pane)
      // 预览面板在正文框旁边，按钮在页面最下面 —— 不滚过去看着像没反应
      pane.preview.scrollIntoView({ behavior: 'smooth', block: 'center' })
    })

  /* ---------------- 图库与导入 ---------------- */

  function insertAtCursor(text: string) {
    const pane = activePane
    if (!pane) return
    const body = pane.body
    const start = body.selectionStart ?? body.value.length
    const end = body.selectionEnd ?? body.value.length
    body.value = body.value.slice(0, start) + text + body.value.slice(end)
    body.focus()
    bodyChanged(pane)
  }

  document
    .querySelector<HTMLButtonElement>('[data-admin-media-button]')
    ?.addEventListener('click', async () => {
      if (!picker) return
      if (!picker.hidden) {
        picker.hidden = true
        return
      }
      try {
        const data = await api<{ media: MediaRow[] }>('/api/admin/media')
        picker.textContent = ''
        for (const item of data.media) {
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'admin-media-picker__item'
          const image = document.createElement('img')
          image.src = '/media/' + item.key;
          image.alt = item.alt;
          image.loading = 'lazy'
          button.appendChild(image)
          button.addEventListener('click', () => {
            insertAtCursor('![' + (item.alt || '') + '](/media/' + item.key + ')')
          })
          picker.appendChild(button)
        }
        picker.hidden = false
      } catch (error) {
        const failure = error as { code?: string }
        say(errorText(locale, failure.code ?? 'request_failed'), true)
      }
    })

  document
    .querySelector<HTMLInputElement>('[data-admin-import]')
    ?.addEventListener('change', async (event) => {
      const input = event.target as HTMLInputElement
      const file = input.files?.[0]
      const pane = activePane
      if (!file || !pane) return
      const parsed = parseFrontmatter(await file.text())
      const fields = parsed.fields
      const title = typeof fields.title === 'string' ? fields.title : ''
      const description = typeof fields.description === 'string' ? fields.description : ''
      const category = typeof fields.category === 'string' ? fields.category : ''
      const license = typeof fields.license === 'string' ? fields.license : ''
      const pubDate = typeof fields.pubDate === 'string' ? fields.pubDate : ''
      const tags = Array.isArray(fields.tags) ? fields.tags.join(', ') : ''
      setLangField('title', pane.lang, title)
      setLangField('description', pane.lang, description)
      setField('category', category)
      setField('license', license)
      setField('pubDate', pubDate.slice(0, 10))
      setField('tags', tags)
      setLangField('body', pane.lang, parsed.body)
      if (!field('slug')?.value) {
        setField('slug', title.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/[\s_]+/g, '-'))
      }
      bodyChanged(pane)
      say(t(locale, 'admin.hint.imported'))
    })

  /* ---------------- 载入 ---------------- */

  /** 另一种语言的那一版 —— 同一 slug 下换个语言就是它 */
  async function loadSibling() {
    const slug = (field('slug')?.value ?? '').trim()
    if (!slug) return
    const other: Lang = currentLang === 'zh' ? 'en' : 'zh'
    try {
      const data = await api<{ document: DocumentRow | null }>(
        '/api/admin/documents?slug=' + encodeURIComponent(slug) + '&locale=' + other,
      )
      if (data.document) fillDoc(other, data.document)
      else clearDoc(other)
      const pane = panes.find((item) => item.lang === other)
      if (pane) void refreshPreview(pane)
    } catch (error) {
      const failure = error as { code?: string }
      say(errorText(locale, failure.code ?? 'request_failed'), true)
    }
  }

  async function load() {
    if (docId === 'new') {
      renderStatus()
      return
    }
    try {
      const data = await api<{ document: DocumentRow }>('/api/admin/documents/' + docId)
      const doc = data.document
      currentLang = doc.locale === 'en' ? 'en' : 'zh'
      fillShared(doc)
      fillDoc(currentLang, doc)
      renderStatus()
      await loadSibling()
      const pane = panes.find((item) => item.lang === currentLang)
      if (pane) void refreshPreview(pane)
    } catch (error) {
      const failure = error as { code?: string }
      say(errorText(locale, failure.code ?? 'request_failed'), true)
    }
  }

  // slug 改了 —— 另一语言的那一版要跟着换
  field('slug')?.addEventListener('change', () => void loadSibling())

  // 没保存就离开 —— 别把改了一半的内容丢掉
  window.addEventListener('beforeunload', (event) => {
    if (!dirty) return
    event.preventDefault()
    event.returnValue = ''
  });

  /* ---------------- 起手 ---------------- */

  for (const lang of LANGS) {
    const tools = document.querySelector<HTMLElement>('[data-admin-tools="' + lang + '"]')
    const body = document.querySelector<HTMLTextAreaElement>('[name="body-' + lang + '"]')
    const preview = document.querySelector<HTMLElement>('[data-admin-preview="' + lang + '"]')
    if (!tools || !body || !preview) continue
    const pane: Pane = { lang, tools, body, preview, timer: 0, seq: 0 }
    panes.push(pane)
    renderTools(pane)
    body.addEventListener('focus', () => {
      activePane = pane
    });
  }
  activePane = panes[0] ?? null

  void load()
</script>