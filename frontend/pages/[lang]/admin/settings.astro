---
/**
 * 站点设置 —— 全站默认文字的展示与修改。
 *
 * 「默认文字」= 语言包里的全部词条（站点信息、导航、文章、标签、后台……）。
 * 改完存到 D1，构建期导出成 i18n-overrides.json 叠在词典上。
 *
 * 左边是表单，右边**就是站点本身** —— 改一个字，预览里立刻变。
 * 改完离开输入框就落盘，不用再点一次「保存」。
 */
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'
import { t, type Locale } from '../../../i18n'

const locale = (Astro.params.lang as Locale) ?? 'zh'
---

<AdminLayout
  locale={locale}
  section="settings"
  title={t(locale, 'admin.settings.title')}
  intro={t(locale, 'admin.settings.intro')}
>
  <div class="admin-settings__top">
    <div class="admin-settings__stack">
      <!-- 站点信息：最常改的几条，摆最上面 -->
      <section class="admin-card">
        <h2 class="admin-card__title">{t(locale, 'admin.settings.info')}</h2>
        <p class="admin-card__hint">{t(locale, 'admin.settings.infoHint')}</p>
        <div class="admin-settings__info" data-admin-info></div>
      </section>

      <!-- 页脚：页脚上显示的每一句都在这儿改 -->
      <section class="admin-card">
        <h2 class="admin-card__title">{t(locale, 'admin.settings.footer')}</h2>
        <p class="admin-card__hint">{t(locale, 'admin.settings.footerHint')}</p>
        <div class="admin-settings__info" data-admin-footer-box></div>
      </section>
    </div>

    <!-- 实时预览：真的把站点装进框里，改了什么立刻看得见 -->
    <!-- 别用 admin-preview —— 那是编辑器的 markdown 预览，两处同名会互相套样式 -->
    <section class="admin-card admin-live">
      <div class="admin-settings__bar">
        <h2 class="admin-card__title">{t(locale, 'admin.settings.preview')}</h2>
        <div class="admin-live__modes">
          <button class="ui-btn ui-btn--primary" type="button" data-admin-preview-mode="home">
            {t(locale, 'admin.settings.previewHome')}
          </button>
          <button class="ui-btn" type="button" data-admin-preview-mode="about">
            {t(locale, 'admin.settings.previewAbout')}
          </button>
          <button class="ui-btn" type="button" data-admin-preview-mode="footer">
            {t(locale, 'admin.settings.previewFooter')}
          </button>
        </div>
      </div>
      <p class="admin-card__hint">{t(locale, 'admin.settings.previewHint')}</p>
      <div class="admin-live__frame" data-admin-preview-box>
        <iframe class="admin-live__iframe" data-admin-preview title={t(locale, 'admin.settings.preview')}></iframe>
      </div>
    </section>
  </div>

  <!-- 界面文案：全量词条，可搜索、可按模块筛、分页翻 -->
  <section class="admin-card">
    <div class="admin-settings__bar">
      <h2 class="admin-card__title">{t(locale, 'admin.settings.copy')}</h2>
      <input
        class="ui-input admin-search"
        type="search"
        placeholder={t(locale, 'admin.settings.searchPlaceholder')}
        data-admin-search
      />
      <select class="ui-input admin-select" data-admin-module></select>
    </div>
    <div class="admin-settings__list" data-admin-entries></div>
    <div class="admin-pager" data-admin-pager></div>
  </section>

  <div class="admin-actionbar admin-actionbar--sticky" data-admin-footer>
    <span class="admin-actionbar__meta" data-admin-count></span>
    <div class="admin-actionbar__buttons">
      <button class="ui-btn" type="button" data-admin-reset-all>
        {t(locale, 'admin.settings.resetAll')}
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  import { interpolate, t } from '../../../i18n'
  import { api, errorText } from '../../../../backend/lib/admin/client'
  import { ATTR } from '../../../lib/dom-contract'
  import { FOOTER_HEIGHT_KEY, MAX_FOOTER_HEIGHT, parseFooterMinHeight } from '../../../lib/footer-height.ts'

  interface Entry {
    key: string
    zh: string
    en: string
    defaultZh: string
    defaultEn: string
    overridden: boolean
  }

  /** 预览的三个面：改哪一块就看哪一面 */
  type PreviewMode = 'home' | 'about' | 'footer'

  const locale = document.documentElement.lang === 'en' ? 'en' : 'zh'
  const flash = document.querySelector<HTMLElement>('[data-admin-flash]')
  const infoBox = document.querySelector<HTMLElement>('[data-admin-info]')
  const footerBox = document.querySelector<HTMLElement>('[data-admin-footer-box]')
  const listBox = document.querySelector<HTMLElement>('[data-admin-entries]')
  const searchInput = document.querySelector<HTMLInputElement>('[data-admin-search]')
  const moduleSelect = document.querySelector('[data-admin-module]') as HTMLSelectElement | null
  const pagerBox = document.querySelector<HTMLElement>('[data-admin-pager]')
  const countLabel = document.querySelector<HTMLElement>('[data-admin-count]')
  const previewBox = document.querySelector<HTMLElement>('[data-admin-preview-box]')
  const previewFrame = document.querySelector<HTMLIFrameElement>('[data-admin-preview]')
  const modeButtons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-admin-preview-mode]'),
  ]

  /** 站点信息：这几条最常改，单独摆出来 */
  const INFO_KEYS = ['site.name', 'site.author', 'site.tagline', 'site.email']

  /** 页脚那张卡里的条目 —— 都有自己的控件，不进「界面文案」列表 */
  const FOOTER_TEXT_KEYS = [
    { key: 'footer.icp', placeholder: 'admin.settings.icpHint' },
    { key: 'footer.copyright' },
    { key: 'footer.builtWith' },
    { key: 'footer.custom', multiline: true, placeholder: 'admin.settings.footerCustom' },
  ]

  /** 每页多少条 —— 三百多条一次铺开，既慢又找不着 */
  const PAGE_SIZE = 20

  /** 预览里的视口尺寸 —— 桌面宽度，缩放后塞进右边的框 */
  const PREVIEW_WIDTH = 1280
  const PREVIEW_HEIGHT = 1400

  /** 改哪条 → 预览切到哪一面 */
  const PREVIEW_MODE_OF: Record<string, PreviewMode> = {
    'site.name': 'home',
    'site.author': 'home',
    'site.tagline': 'home',
    'site.email': 'about',
    'footer.icp': 'footer',
    'footer.copyright': 'footer',
    'footer.builtWith': 'footer',
    'footer.custom': 'footer',
  }

  let entries: Entry[] = []
  let page = 1
  let previewMode: PreviewMode = 'home'
  /** 正在落盘的条数 —— 还没存完就别让页面离开 */
  let saving = 0
  /** 改了但还没落盘的值 —— key → {zh, en} */
  const touched = new Map<string, { zh: string; en: string }>()
  /** 保存排队 —— 连着改两个字段时，后一个要等前一个存完 */
  let saveChain: Promise<void> = Promise.resolve()

  function say(message: string, isError = false) {
    if (!flash) return
    flash.textContent = message
    flash.classList.toggle('admin-flash--error', isError)
    flash.hidden = false
    flash.classList.add('admin-flash--visible')
  }

  /** 当前生效的值（服务端存的值 + 还没落盘的改动） */
  function current(entry: Entry): { zh: string; en: string } {
    return touched.get(entry.key) ?? { zh: entry.zh, en: entry.en }
  }

  /** 某条的当前值（按界面语言）—— 预览用 */
  function valueOf(key: string): string {
    const entry = entries.find((item) => item.key === key)
    if (!entry) return ''
    return current(entry)[locale === 'en' ? 'en' : 'zh']
  }

  function moduleOf(key: string): string {
    const dot = key.indexOf('.')
    return dot === -1 ? key : key.slice(0, dot)
  }

  /** 页脚那几条有自己的卡 —— 不进「界面文案」列表，也不进模块下拉 */
  function isFooterKey(key: string): boolean {
    return key === FOOTER_HEIGHT_KEY || FOOTER_TEXT_KEYS.some((item) => item.key === key)
  }

  /** 站点信息与页脚都有自己的卡 —— 进了文案列表就多一个入口 */
  function isDedicatedKey(key: string): boolean {
    return isFooterKey(key) || INFO_KEYS.includes(key)
  }

  function markDirty(entry: Entry, zh: string, en: string) {
    touched.set(entry.key, { zh, en })
    applyPreview()
    renderCount()
  }

  /* ---------------- 存 ---------------- */

  /** 存一条 —— 排队，免得连着改两个字段时后一个把前一个盖了 */
  function saveEntry(entry: Entry): Promise<void> {
    saveChain = saveChain.then(() => doSave(entry))
    return saveChain
  }

  async function doSave(entry: Entry): Promise<void> {
    const value = current(entry)
    saving += 1
    renderCount()
    try {
      await api('/api/admin/settings', {
        method: 'PUT',
        body: JSON.stringify({ entries: [{ key: entry.key, zh: value.zh, en: value.en }] }),
      })
      entry.zh = value.zh
      entry.en = value.en
      entry.overridden = value.zh !== entry.defaultZh || value.en !== entry.defaultEn
      touched.delete(entry.key)
      clearFieldError(entry)
      renderBadge(entry)
    } catch (error) {
      // 没存上：改好的值留着，标在框上 —— 作者看得见哪儿没存进去
      markFieldError(entry, errorText(locale, (error as { code?: string }).code ?? 'request_failed'))
    } finally {
      saving -= 1
      renderCount()
    }
  }

  /** 没存上：标在对应的输入框上 */
  function markFieldError(entry: Entry, message: string) {
    for (const input of document.querySelectorAll<HTMLElement>(
      '[data-admin-field^="' + entry.key + ':"]',
    )) {
      input.setAttribute('aria-invalid', 'true')
      const wrap = input.closest('.admin-settings__field')
      if (!wrap) continue
      let note = wrap.querySelector<HTMLElement>('.admin-field__error')
      if (!note) {
        note = document.createElement('span')
        note.className = 'admin-field__error'
        wrap.appendChild(note)
      }
      note.textContent = message
    }
  }

  function clearFieldError(entry: Entry) {
    for (const input of document.querySelectorAll<HTMLElement>(
      '[data-admin-field^="' + entry.key + ':"]',
    )) {
      input.removeAttribute('aria-invalid')
      input.closest('.admin-settings__field')?.querySelector('.admin-field__error')?.remove()
    }
  }

  /* ---------------- 表单件 ---------------- */

  /**
   * 一个输入框 —— 改完离开就落盘。
   * 默认值放进占位符：一眼看得出「原来是什么」。
   */
  function entryInput(entry: Entry, lang: 'zh' | 'en', multiline = false): HTMLElement {
    const wrap = document.createElement('label')
    wrap.className = 'admin-settings__field'
    const caption = document.createElement('span')
    caption.className = 'admin-settings__label'
    caption.textContent =
      lang === 'zh' ? t(locale, 'admin.settings.hintZh') : t(locale, 'admin.settings.hintEn')
    const input = multiline ? document.createElement('textarea') : document.createElement('input')
    if (!multiline) (input as HTMLInputElement).type = 'text'
    if (multiline) (input as HTMLTextAreaElement).rows = 3
    input.className = 'ui-input'
    input.dataset.adminField = entry.key + ':' + lang
    input.value = current(entry)[lang]
    const fallback = lang === 'zh' ? entry.defaultZh : entry.defaultEn
    input.placeholder = fallback
      ? t(locale, 'admin.settings.defaultPlaceholder', { value: fallback })
      : ''
    input.addEventListener('input', () => {
      const value = current(entry)
      markDirty(entry, lang === 'zh' ? input.value : value.zh, lang === 'en' ? input.value : value.en)
    })
    input.addEventListener('change', () => void saveEntry(entry))
    input.addEventListener('focus', () => setPreviewMode(PREVIEW_MODE_OF[entry.key] ?? previewMode))
    wrap.appendChild(caption)
    wrap.appendChild(input)
    return wrap
  }

  function keyLabel(key: string): HTMLElement {
    const label = document.createElement('span')
    label.className = 'admin-settings__key'
    label.textContent = key
    return label
  }

  /** 恢复默认 —— 送回默认值；服务端看到与默认相同就删掉那一行 */
  function resetButton(entry: Entry): HTMLElement {
    const reset = document.createElement('button')
    reset.className = 'ui-btn admin-settings__reset'
    reset.type = 'button'
    reset.textContent = t(locale, 'admin.settings.reset')
    reset.addEventListener('click', () => {
      touched.set(entry.key, { zh: entry.defaultZh, en: entry.defaultEn })
      void saveEntry(entry).then(() => {
        renderInfo()
        renderFooterBox()
        renderList()
      })
    })
    return reset
  }

  /** 行尾两个小动作 —— 恢复默认 + 「已修改」标记，收在一起 */
  function rowActions(entry: Entry): HTMLElement {
    const box = document.createElement('div')
    box.className = 'admin-settings__actions'
    box.appendChild(resetButton(entry))
    box.appendChild(badge(entry))
    return box
  }

  /** 「已修改」标记 —— 改过的条目一眼能挑出来 */
  function badge(entry: Entry): HTMLElement {
    const element = document.createElement('span')
    element.className = 'admin-tag admin-tag--published'
    element.dataset.adminBadge = entry.key
    element.textContent = t(locale, 'admin.settings.overridden')
    element.hidden = !entry.overridden
    return element
  }

  function renderBadge(entry: Entry): void {
    const element = document.querySelector<HTMLElement>('[data-admin-badge="' + entry.key + '"]')
    if (element) element.hidden = !entry.overridden
  }

  /* ---------------- 站点信息 / 页脚 ---------------- */

  function renderInfo() {
    if (!infoBox) return
    infoBox.textContent = ''
    for (const key of INFO_KEYS) {
      const entry = entries.find((item) => item.key === key)
      if (!entry) continue
      const row = document.createElement('div')
      row.className = 'admin-settings__info-row'
      row.appendChild(keyLabel(key))
      row.appendChild(entryInput(entry, 'zh'))
      row.appendChild(entryInput(entry, 'en'))
      row.appendChild(rowActions(entry))
      infoBox.appendChild(row)
    }
  }

  /** 页脚那张卡 —— 页脚上显示的每一句都在这儿改 */
  function renderFooterBox() {
    if (!footerBox) return
    footerBox.textContent = ''
    for (const item of FOOTER_TEXT_KEYS) {
      const entry = entries.find((row) => row.key === item.key)
      if (!entry) continue
      const row = document.createElement('div')
      row.className = 'admin-settings__info-row'
      row.appendChild(keyLabel(item.key))
      row.appendChild(entryInput(entry, 'zh', item.multiline))
      row.appendChild(entryInput(entry, 'en', item.multiline))
      row.appendChild(rowActions(entry))
      footerBox.appendChild(row)
    }
    renderFooterHeight(footerBox)
  }

  /** 页脚卡片最小高度 —— 数值设置：两份语言写同一个数，只有这一个控件能改它 */
  function renderFooterHeight(box: HTMLElement | null) {
    if (!box) return
    const entry = entries.find((item) => item.key === FOOTER_HEIGHT_KEY)
    if (!entry) return

    const row = document.createElement('div')
    row.className = 'admin-settings__info-row admin-settings__info-row--single'

    row.appendChild(keyLabel(FOOTER_HEIGHT_KEY))

    const wrap = document.createElement('label')
    wrap.className = 'admin-settings__field'
    const caption = document.createElement('span')
    caption.className = 'admin-settings__label'
    caption.textContent = t(locale, 'admin.settings.footerHeight')
    const input = document.createElement('input')
    input.className = 'ui-input'
    input.type = 'number'
    input.min = '0'
    input.max = String(MAX_FOOTER_HEIGHT)
    input.step = '10'
    input.dataset.adminField = entry.key + ':zh'
    input.value = current(entry).zh
    input.addEventListener('input', () => {
      const next = String(parseFooterMinHeight(input.value))
      markDirty(entry, next, next)
    })
    input.addEventListener('change', () => void saveEntry(entry))
    const hint = document.createElement('span')
    hint.className = 'admin-settings__hint'
    hint.textContent = t(locale, 'admin.settings.footerHeightHint')
    wrap.appendChild(caption)
    wrap.appendChild(input)
    wrap.appendChild(hint)
    row.appendChild(wrap)

    row.appendChild(rowActions(entry))

    box.appendChild(row)
  }

  /* ---------------- 界面文案（分页） ---------------- */

  function visibleEntries(): Entry[] {
    const term = (searchInput?.value ?? '').trim().toLowerCase()
    const moduleName = moduleSelect?.value ?? ''
    return entries.filter((entry) => {
      if (isDedicatedKey(entry.key)) return false
      if (moduleName && moduleOf(entry.key) !== moduleName) return false
      if (!term) return true
      const values = current(entry)
      return (
        entry.key.toLowerCase().includes(term) ||
        values.zh.toLowerCase().includes(term) ||
        values.en.toLowerCase().includes(term)
      )
    })
  }

  function listRow(entry: Entry): HTMLElement {
    const row = document.createElement('div')
    row.className = 'admin-settings__row'
    row.appendChild(keyLabel(entry.key))
    row.appendChild(entryInput(entry, 'zh'))
    row.appendChild(entryInput(entry, 'en'))
    row.appendChild(rowActions(entry))
    return row
  }

  function renderList() {
    if (!listBox) return
    const visible = visibleEntries()
    const pages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE))
    if (page > pages) page = pages
    const start = (page - 1) * PAGE_SIZE

    listBox.textContent = ''
    const slice = visible.slice(start, start + PAGE_SIZE)
    if (slice.length === 0) {
      const empty = document.createElement('p')
      empty.className = 'admin__hint'
      empty.textContent = t(locale, 'admin.list.empty')
      listBox.appendChild(empty)
    } else {
      for (const entry of slice) listBox.appendChild(listRow(entry))
    }
    renderPager(pages, visible.length)
  }

  function renderPager(pages: number, total: number) {
    if (!pagerBox) return
    pagerBox.textContent = ''
    if (pages <= 1) return

    const prev = document.createElement('button')
    prev.className = 'ui-btn'
    prev.type = 'button'
    prev.textContent = t(locale, 'admin.settings.prev')
    prev.disabled = page === 1
    prev.addEventListener('click', () => {
      page -= 1
      renderList()
    })

    const label = document.createElement('span')
    label.className = 'admin-pager__label'
    label.textContent = t(locale, 'admin.settings.page', { page, pages, total })

    const next = document.createElement('button')
    next.className = 'ui-btn'
    next.type = 'button'
    next.textContent = t(locale, 'admin.settings.next')
    next.disabled = page === pages
    next.addEventListener('click', () => {
      page += 1
      renderList()
    })

    pagerBox.appendChild(prev)
    pagerBox.appendChild(label)
    pagerBox.appendChild(next)
  }

  function renderModules() {
    if (!moduleSelect) return
    const modules = [
      ...new Set(entries.filter((e) => !isDedicatedKey(e.key)).map((e) => moduleOf(e.key))),
    ].sort()
    moduleSelect.textContent = ''
    const all = document.createElement('option')
    all.value = ''
    all.textContent = t(locale, 'admin.settings.allModules')
    moduleSelect.appendChild(all)
    for (const name of modules) {
      const option = document.createElement('option')
      option.value = name
      option.textContent = name
      moduleSelect.appendChild(option)
    }
  }

  function renderCount() {
    if (!countLabel) return
    if (saving > 0) {
      countLabel.textContent = t(locale, 'admin.settings.saving')
      return
    }
    const overridden = entries.filter((entry) => entry.overridden).length
    countLabel.textContent = t(locale, 'admin.settings.overriddenCount', { count: overridden })
  }

  /* ---------------- 实时预览 ---------------- */

  /** 把真实页面缩进右边的框里 */
  function fitPreview(): void {
    if (!previewFrame || !previewBox) return
    const width = previewBox.clientWidth
    const height = previewBox.clientHeight
    if (width <= 0 || height <= 0) return
    const scale = Math.min(width / PREVIEW_WIDTH, height / PREVIEW_HEIGHT)
    previewFrame.style.width = PREVIEW_WIDTH + 'px'
    previewFrame.style.height = PREVIEW_HEIGHT + 'px'
    previewFrame.style.transform = 'scale(' + scale + ')'
  }

  /** 预览：把改过的文案贴回真实页面 */
  function applyPreview(): void {
    const doc = previewFrame?.contentDocument
    if (!doc) return
    for (const element of doc.querySelectorAll('[' + ATTR.copy + ']')) {
      const key = element.getAttribute(ATTR.copy)
      if (!key) continue
      const entry = entries.find((item) => item.key === key)
      if (!entry) continue
      const raw = current(entry)[locale === 'en' ? 'en' : 'zh']
      const value = interpolate(raw, {
        year: String(new Date().getFullYear()),
        name: valueOf('site.author'),
      })
      if (key === 'footer.custom') element.innerHTML = value
      else element.textContent = value
      // 邮箱的链接也得跟着改
      if (element instanceof HTMLAnchorElement && element.getAttribute('href')?.startsWith('mailto:')) {
        element.setAttribute('href', 'mailto:' + raw)
      }
    }
    applyIcpPreview(doc)
  }

  /**
   * 备案号：页面上只有填了数字才渲染成链接 —— 预览按同样的规矩来。
   * 不照抄这条规矩，预览里就会凭空多出一个站点上并不存在的链接。
   */
  function applyIcpPreview(doc: Document): void {
    const entry = entries.find((item) => item.key === 'footer.icp')
    if (!entry) return
    const value = current(entry)[locale === 'en' ? 'en' : 'zh']
    const number = value.match(/\d+/)?.[0] ?? ''
    const box = doc.querySelector('.footer-links')
    if (!box) return
    const link = doc.querySelector('[' + ATTR.copy + '="footer.icp"]')
    if (!number) {
      link?.remove()
      return
    }
    const target = link ?? doc.createElement('a')
    if (!link) {
      target.setAttribute(ATTR.copy, 'footer.icp')
      target.setAttribute('target', '_blank')
      box.appendChild(target)
    }
    target.textContent = value
    target.setAttribute('href', 'https://icp.gov.moe/?keyword=' + number)
  }

  /**
   * 预览里点某句话 → 跳到要改的那一条。
   * 搜索 / 筛选会把它藏起来，所以先清掉再定位；定位到就把光标放进输入框，
   * 点一下就能直接改，不用自己在三百多条里翻。
   */
  function jumpToEntry(key: string): void {
    if (!entries.some((item) => item.key === key)) return
    if (searchInput) searchInput.value = ''
    if (moduleSelect) moduleSelect.value = ''

    if (isFooterKey(key)) {
      footerBox?.scrollIntoView({ block: 'center', behavior: 'smooth' })
    } else if (INFO_KEYS.includes(key)) {
      infoBox?.scrollIntoView({ block: 'center', behavior: 'smooth' })
    } else {
      const index = visibleEntries().findIndex((item) => item.key === key)
      if (index >= 0) {
        page = Math.floor(index / PAGE_SIZE) + 1
        renderList()
      }
      listBox?.scrollIntoView({ block: 'center', behavior: 'smooth' })
    }

    const input = document.querySelector<HTMLInputElement>('[data-admin-field="' + key + ':zh"]')
    if (!input) return
    input.scrollIntoView({ block: 'center', behavior: 'smooth' })
    input.focus({ preventScroll: true })
    input.select()
  }

  /**
   * 预览里的字可以点：点谁就跳到谁。
   * 每换一次面（导航）都是一个新 document，所以监听在 load 里重挂。
   */
  function bindPreview(): void {
    const doc = previewFrame?.contentDocument
    if (!doc?.head) return
    // 可点的提示只能注入 iframe 里 —— 外层样式管不到别的 document
    const hint = doc.createElement('style')
    hint.textContent =
      '[' + ATTR.copy + ']{cursor:pointer}' +
      '[' + ATTR.copy + ']:hover{outline:2px solid currentColor;outline-offset:3px;border-radius:4px}'
    doc.head.appendChild(hint)
    doc.addEventListener('click', (event) => {
      const target = event.target as Element | null
      const marked = target?.closest('[' + ATTR.copy + ']')
      // 预览用来看效果，不是用来逛站点的 —— 任何链接都不跟随
      if (target?.closest('a')) event.preventDefault()
      if (!marked) return
      // 可改的那句话：连站点自己的跳转也不做，直接跳到词条
      event.stopPropagation()
      const key = marked.getAttribute(ATTR.copy)
      if (key) jumpToEntry(key)
    })
  }

  function scrollPreviewTo(where: 'top' | 'bottom'): void {
    const win = previewFrame?.contentWindow
    const doc = win?.document
    if (!win || !doc) return
    win.scrollTo(0, where === 'bottom' ? doc.body.scrollHeight : 0)
  }

  function setPreviewMode(mode: PreviewMode): void {
    if (mode === previewMode) return
    previewMode = mode
    for (const button of modeButtons) {
      button.classList.toggle('ui-btn--primary', button.dataset.adminPreviewMode === mode)
    }
    const src = mode === 'about' ? '/' + locale + '/about/' : '/' + locale + '/'
    if (previewFrame && previewFrame.getAttribute('src') !== src) {
      previewFrame.setAttribute('src', src)
    } else {
      applyPreview()
      // 同一页换一面：页脚要滚到底，其余回到顶上
      scrollPreviewTo(mode === 'footer' ? 'bottom' : 'top')
    }
  }

  /* ---------------- 起手 ---------------- */

  async function load() {
    try {
      const data = await api<{ entries: Entry[] }>('/api/admin/settings')
      entries = data.entries
      touched.clear()
      renderModules()
      renderInfo()
      renderFooterBox()
      renderList()
      renderCount()
      applyPreview()
    } catch (error) {
      say(errorText(locale, (error as { code?: string }).code ?? 'request_failed'), true)
    }
  }

  searchInput?.addEventListener('input', () => {
    page = 1
    renderList()
  })
  moduleSelect?.addEventListener('change', () => {
    page = 1
    renderList()
  })

  for (const button of modeButtons) {
    button.addEventListener('click', () => {
      setPreviewMode((button.dataset.adminPreviewMode as PreviewMode) ?? 'home')
    })
  }

  previewFrame?.addEventListener('load', () => {
    fitPreview()
    applyPreview()
    bindPreview()
    scrollPreviewTo(previewMode === 'footer' ? 'bottom' : 'top')
  })

  window.addEventListener('resize', fitPreview)

  document.querySelector<HTMLButtonElement>('[data-admin-reset-all]')?.addEventListener('click', async () => {
    if (!confirm(t(locale, 'admin.settings.confirmResetAll'))) return
    const overrides = entries.filter((entry) => entry.overridden)
    if (overrides.length === 0) return
    try {
      await api('/api/admin/settings', {
        method: 'PUT',
        body: JSON.stringify({
          entries: overrides.map((entry) => ({
            key: entry.key,
            zh: entry.defaultZh,
            en: entry.defaultEn,
          })),
        }),
      })
      await load()
      say(t(locale, 'admin.settings.saved'))
    } catch (error) {
      say(errorText(locale, (error as { code?: string }).code ?? 'request_failed'), true)
    }
  })

  // 还没存完就离开 —— 别把改了一半的文案丢掉
  window.addEventListener('beforeunload', (event) => {
    if (saving === 0) return
    event.preventDefault()
  })

  previewFrame?.setAttribute('src', '/' + locale + '/')
  fitPreview()
  void load()
</script>
