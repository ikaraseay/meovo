---
/**
 * 站点设置 —— 全站默认文字的展示与修改。
 *
 * 「默认文字」= 语言包里的全部词条（站点信息、导航、文章、标签、后台……）。
 * 改完存到 D1，构建期导出成 i18n-overrides.json 叠在词典上。
 */
export const prerender = false

import AdminLayout from '../../../layouts/AdminLayout.astro'
import { t, type Locale } from '../../../i18n'

const locale = (Astro.params.lang as Locale) ?? 'zh'
---

<AdminLayout
  locale={locale}
  section="settings"
  title={t(locale, 'admin.settings.title')}
  intro={t(locale, 'admin.settings.intro')}
>
  <!-- 站点信息：最常改的几条，摆最上面 -->
  <section class="admin-card">
    <h2 class="admin-card__title">{t(locale, 'admin.settings.info')}</h2>
    <p class="admin-card__hint">{t(locale, 'admin.settings.infoHint')}</p>
    <div class="admin-settings__info" data-admin-info></div>
  </section>

  <!-- 页脚：页脚上显示的每一句都在这儿改 -->
  <section class="admin-card">
    <h2 class="admin-card__title">{t(locale, 'admin.settings.footer')}</h2>
    <p class="admin-card__hint">{t(locale, 'admin.settings.footerHint')}</p>
    <div class="admin-settings__info" data-admin-footer-box></div>
  </section>

  <!-- 界面文案：全量词条，可搜索、可按模块筛 -->
  <section class="admin-card">
    <div class="admin-settings__bar">
      <h2 class="admin-card__title">{t(locale, 'admin.settings.copy')}</h2>
      <input
        class="ui-input admin-search"
        type="search"
        placeholder={t(locale, 'admin.settings.searchPlaceholder')}
        data-admin-search
      />
      <select class="ui-input admin-select" data-admin-module></select>
    </div>
    <div class="admin-settings__list" data-admin-entries></div>
  </section>

  <div class="admin-actionbar admin-actionbar--sticky" data-admin-footer hidden>
    <span class="admin-actionbar__meta" data-admin-count></span>
    <div class="admin-actionbar__buttons">
      <button class="ui-btn" type="button" data-admin-reset-all>
        {t(locale, 'admin.settings.resetAll')}
      </button>
      <button class="ui-btn ui-btn--primary" type="button" data-admin-save>
        {t(locale, 'admin.settings.save')}
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  import { t } from '../../../i18n'
  import { api, errorText } from '../../../../backend/lib/admin/client'
  import { FOOTER_HEIGHT_KEY, MAX_FOOTER_HEIGHT, parseFooterMinHeight } from '../../../lib/footer-height.ts'

  interface Entry {
    key: string
    zh: string
    en: string
    defaultZh: string
    defaultEn: string
    overridden: boolean
  }

  const locale = document.documentElement.lang === 'en' ? 'en' : 'zh'
  const flash = document.querySelector<HTMLElement>('[data-admin-flash]')
  const infoBox = document.querySelector<HTMLElement>('[data-admin-info]')
  const listBox = document.querySelector<HTMLElement>('[data-admin-entries]')
  const searchInput = document.querySelector<HTMLInputElement>('[data-admin-search]')
  const moduleSelect = document.querySelector('[data-admin-module]') as HTMLSelectElement | null
  const footer = document.querySelector<HTMLElement>('[data-admin-footer]')
  const countLabel = document.querySelector<HTMLElement>('[data-admin-count]')
  const footerBox = document.querySelector<HTMLElement>('[data-admin-footer-box]')

  /** 页脚那张卡里的条目 —— 都有自己的控件，不进「界面文案」列表 */
  const FOOTER_TEXT_KEYS = [
    { key: 'footer.icp', placeholder: 'admin.settings.icpHint' },
    { key: 'footer.copyright' },
    { key: 'footer.builtWith' },
    { key: 'footer.custom', multiline: true },
  ]

  /** 站点信息：这几条最常改，单独摆出来 */
  const INFO_KEYS = ['site.name', 'site.author', 'site.tagline', 'site.email']

  /** 页脚那几条有自己的卡 —— 不进「界面文案」列表，也不进模块下拉 */
  function isFooterKey(key: string): boolean {
    return key === FOOTER_HEIGHT_KEY || FOOTER_TEXT_KEYS.some((item) => item.key === key)
  }

  let entries: Entry[] = []
  /** 用户动过的条目：key → 想要的值（等于默认值时保存即删除那行） */
  const touched = new Map<string, { zh: string; en: string }>()

  function say(message: string, isError = false) {
    if (!flash) return
    flash.textContent = message
    flash.classList.toggle('admin-flash--error', isError)
    flash.hidden = false
    flash.classList.add('admin-flash--visible')
  }

  /** 当前生效的值（服务端存的值 + 未保存的改动） */
  function current(entry: Entry): { zh: string; en: string } {
    return touched.get(entry.key) ?? { zh: entry.zh, en: entry.en }
  }

  function moduleOf(key: string): string {
    const dot = key.indexOf('.')
    return dot === -1 ? key : key.slice(0, dot)
  }

  /** 真正跟「服务端存的值」不一样的条数 */
  function changedCount(): number {
    let count = 0
    for (const [key, value] of touched) {
      const entry = entries.find((item) => item.key === key)
      if (!entry || entry.zh !== value.zh || entry.en !== value.en) count += 1
    }
    return count
  }

  function updateFooter() {
    if (!footer || !countLabel) return
    const count = changedCount()
    footer.hidden = count === 0
    countLabel.textContent = t(locale, 'admin.settings.dirty', { count })
  }

  function markDirty(entry: Entry, zh: string, en: string) {
    touched.set(entry.key, { zh, en })
    updateFooter()
  }

  function field(
    label: string,
    value: string,
    onInput: (next: string) => void,
    placeholder?: string,
    multiline = false,
  ): HTMLElement {
    const wrap = document.createElement('label')
    wrap.className = 'admin-settings__field'
    const caption = document.createElement('span')
    caption.className = 'admin-settings__label'
    caption.textContent = label
    let input: HTMLInputElement | HTMLTextAreaElement
    if (multiline) {
      const area = document.createElement('textarea')
      area.rows = 3
      input = area
    } else {
      const box = document.createElement('input')
      box.type = 'text'
      input = box
    }
    input.className = 'ui-input'
    input.value = value
    if (placeholder) input.placeholder = placeholder
    input.addEventListener('input', () => onInput(input.value))
    wrap.appendChild(caption)
    wrap.appendChild(input)
    return wrap
  }

  function renderInfo() {
    if (!infoBox) return
    infoBox.textContent = ''
    for (const key of INFO_KEYS) {
      const entry = entries.find((item) => item.key === key)
      if (!entry) continue
      const values = current(entry)
      const row = document.createElement('div')
      row.className = 'admin-settings__info-row'
      const keyLabel = document.createElement('span')
      keyLabel.className = 'admin-settings__key'
      keyLabel.textContent = key
      row.appendChild(keyLabel)
      row.appendChild(
        field(t(locale, 'admin.settings.hintZh'), values.zh, (next) => {
          const other = current(entry).en
          markDirty(entry, next, other)
          renderList()
        }),
      )
      row.appendChild(
        field(t(locale, 'admin.settings.hintEn'), values.en, (next) => {
          const other = current(entry).zh
          markDirty(entry, other, next)
          renderList()
        }),
      )
      infoBox.appendChild(row)
    }
  }

  /** 恢复默认 —— 送回默认值，保存时后端删掉那一行 */
  function resetButton(entry: Entry): HTMLElement {
    const reset = document.createElement('button')
    reset.className = 'ui-btn admin-settings__reset'
    reset.type = 'button'
    reset.textContent = t(locale, 'admin.settings.reset')
    reset.addEventListener('click', () => {
      markDirty(entry, entry.defaultZh, entry.defaultEn)
      renderInfo()
      renderFooterBox()
      renderList()
    })
    return reset
  }

  /** 页脚那张卡 —— 页脚上显示的每一句都在这儿改 */
  function renderFooterBox() {
    if (!footerBox) return
    footerBox.textContent = ''
    for (const item of FOOTER_TEXT_KEYS) {
      const entry = entries.find((row) => row.key === item.key)
      if (!entry) continue
      const values = current(entry)
      const row = document.createElement('div')
      row.className = 'admin-settings__info-row'
      const keyLabel = document.createElement('span')
      keyLabel.className = 'admin-settings__key'
      keyLabel.textContent = item.key
      row.appendChild(keyLabel)
      const placeholder = item.placeholder ? t(locale, item.placeholder) : undefined
      row.appendChild(
        field(t(locale, 'admin.settings.hintZh'), values.zh, (next) => {
          markDirty(entry, next, current(entry).en)
          renderList()
        }, placeholder, item.multiline),
      )
      row.appendChild(
        field(t(locale, 'admin.settings.hintEn'), values.en, (next) => {
          markDirty(entry, current(entry).zh, next)
          renderList()
        }, placeholder, item.multiline),
      )
      row.appendChild(resetButton(entry))
      footerBox.appendChild(row)
    }
    renderFooterHeight(footerBox)
  }

  /** 页脚卡片最小高度 —— 数值设置：两份语言写同一个数，只有这一个控件能改它 */
  function renderFooterHeight(box: HTMLElement | null) {
    if (!box) return
    const entry = entries.find((item) => item.key === FOOTER_HEIGHT_KEY)
    if (!entry) return

    const row = document.createElement('div')
    row.className = 'admin-settings__info-row admin-settings__info-row--single'

    const keyLabel = document.createElement('span')
    keyLabel.className = 'admin-settings__key'
    keyLabel.textContent = FOOTER_HEIGHT_KEY
    row.appendChild(keyLabel)

    const wrap = document.createElement('label')
    wrap.className = 'admin-settings__field'
    const caption = document.createElement('span')
    caption.className = 'admin-settings__label'
    caption.textContent = t(locale, 'admin.settings.footerHeight')
    const input = document.createElement('input')
    input.className = 'ui-input'
    input.type = 'number'
    input.min = '0'
    input.max = String(MAX_FOOTER_HEIGHT)
    input.step = '10'
    input.value = current(entry).zh
    input.addEventListener('input', () => {
      const next = String(parseFooterMinHeight(input.value))
      markDirty(entry, next, next)
      renderList()
    })
    const hint = document.createElement('span')
    hint.className = 'admin-settings__hint'
    hint.textContent = t(locale, 'admin.settings.footerHeightHint')
    wrap.appendChild(caption)
    wrap.appendChild(input)
    wrap.appendChild(hint)
    row.appendChild(wrap)

    row.appendChild(resetButton(entry))

    box.appendChild(row)
  }

  function renderList() {
    if (!listBox) return
    const term = (searchInput?.value ?? '').trim().toLowerCase()
    const moduleName = moduleSelect?.value ?? ''
    listBox.textContent = ''

    const visible = entries.filter((entry) => {
      // 页脚那几条有自己的卡 —— 进了文案列表就多出一个入口
      if (isFooterKey(entry.key)) return false
      if (moduleName && moduleOf(entry.key) !== moduleName) return false
      if (!term) return true
      const values = current(entry)
      return (
        entry.key.toLowerCase().includes(term) ||
        values.zh.toLowerCase().includes(term) ||
        values.en.toLowerCase().includes(term)
      )
    })

    if (visible.length === 0) {
      const empty = document.createElement('p')
      empty.className = 'admin__hint'
      empty.textContent = t(locale, 'admin.list.empty')
      listBox.appendChild(empty)
      return
    }

    for (const entry of visible) {
      const values = current(entry)
      const row = document.createElement('div')
      row.className = 'admin-settings__row'

      const keyLabel = document.createElement('span')
      keyLabel.className = 'admin-settings__key'
      keyLabel.textContent = entry.key
      row.appendChild(keyLabel)

      row.appendChild(
        field(t(locale, 'admin.settings.hintZh'), values.zh, (next) => {
          const other = current(entry).en
          markDirty(entry, next, other)
          renderInfo()
        }),
      )
      row.appendChild(
        field(t(locale, 'admin.settings.hintEn'), values.en, (next) => {
          const other = current(entry).zh
          markDirty(entry, other, next)
          renderInfo()
        }),
      )

      row.appendChild(resetButton(entry))

      const changed = changedFor(entry)
      if (changed) {
        const badge = document.createElement('span')
        badge.className = 'admin-tag admin-tag--published'
        badge.textContent = t(locale, 'admin.settings.overridden')
        row.appendChild(badge)
      }

      listBox.appendChild(row)
    }
  }

  /** 这一条跟服务端存的值不一样吗 */
  function changedFor(entry: Entry): boolean {
    const value = current(entry)
    return entry.zh !== value.zh || entry.en !== value.en
  }

  function renderModules() {
    if (!moduleSelect) return
    const modules = [
      ...new Set(entries.filter((e) => !isFooterKey(e.key)).map((e) => moduleOf(e.key))),
    ].sort()
    moduleSelect.textContent = ''
    const all = document.createElement('option')
    all.value = ''
    all.textContent = t(locale, 'admin.settings.allModules')
    moduleSelect.appendChild(all)
    for (const name of modules) {
      const option = document.createElement('option')
      option.value = name
      option.textContent = name
      moduleSelect.appendChild(option)
    }
  }

  async function save() {
    if (touched.size === 0) return
    const payload = [...touched.entries()].map(([key, value]) => ({ key, ...value }))
    try {
      await api<{ saved?: number }>(
        '/api/admin/settings',
        {
          method: 'PUT',
          body: JSON.stringify({ entries: payload }),
        },
      )
      touched.clear()
      updateFooter()
      say(t(locale, 'admin.hint.saved'))
      await load()
    } catch (error) {
      say(errorText(locale, (error as { code?: string }).code ?? 'request_failed'), true)
    }
  }

  async function load() {
    try {
      const data = await api<{ entries: Entry[] }>('/api/admin/settings')
      entries = data.entries
      renderModules()
      renderInfo()
      renderFooterBox()
      renderList()
      updateFooter()
    } catch (error) {
      say(errorText(locale, (error as { code?: string }).code ?? 'request_failed'), true)
    }
  }

  searchInput?.addEventListener('input', renderList)
  moduleSelect?.addEventListener('change', renderList)
  document.querySelector<HTMLButtonElement>('[data-admin-save]')?.addEventListener('click', save)
  document.querySelector<HTMLButtonElement>('[data-admin-reset-all]')?.addEventListener('click', async () => {
    if (!confirm(t(locale, 'admin.settings.confirmResetAll'))) return
    for (const entry of entries) {
      if (entry.overridden) touched.set(entry.key, { zh: entry.defaultZh, en: entry.defaultEn })
    }
    updateFooter()
    renderInfo()
    renderFooterBox()
    renderList()
  })

  // 未保存就离开 —— 别把改了一半的文案丢掉
  window.addEventListener('beforeunload', (event) => {
    if (changedCount() === 0) return
    event.preventDefault()
    event.returnValue = ''
  })

  void load()
</script>
